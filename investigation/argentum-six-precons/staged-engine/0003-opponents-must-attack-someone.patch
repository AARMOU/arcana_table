+package com.wingedsheep.engine.mechanics.combat
+
+import com.wingedsheep.engine.handlers.EffectContext
+import com.wingedsheep.engine.handlers.PredicateEvaluator
+import com.wingedsheep.engine.registry.CardRegistry
+import com.wingedsheep.engine.state.GameState
+import com.wingedsheep.engine.state.components.identity.CardComponent
+import com.wingedsheep.engine.state.components.identity.FaceDownComponent
+import com.wingedsheep.engine.state.components.identity.RoomFaceStatics
+import com.wingedsheep.sdk.model.EntityId
+import com.wingedsheep.sdk.scripting.CompositeStaticAbility
+import com.wingedsheep.sdk.scripting.ConditionalStaticAbility
+import com.wingedsheep.sdk.scripting.OpponentsMustAttackWithCreature
+import com.wingedsheep.sdk.scripting.StaticAbility
+
+/**
+ * Reads every relevant static ability controlled by an opponent of the active
+ * attacker. Unlike Trove of Temptation, the source's controller need not be
+ * one of the legal defenders for this combat (three-player/range games).
+ */
+object OpponentsMustAttackWithCreatureRequirement {
+    fun isRequired(
+        state: GameState,
+        cardRegistry: CardRegistry,
+        predicateEvaluator: PredicateEvaluator,
+        attackingPlayer: EntityId,
+    ): Boolean {
+        val opponents = state.getOpponents(attackingPlayer).toSet()
+        val projected = state.projectedState
+        return state.getBattlefield().any { permanentId ->
+            val controller = projected.getController(permanentId)
+            if (controller !in opponents) return@any false
+            val container = state.getEntity(permanentId) ?: return@any false
+            if (container.has<FaceDownComponent>() || projected.hasLostAllAbilities(permanentId)) return@any false
+            val definition = container.get<CardComponent>()
+                ?.let { cardRegistry.getCard(it.cardDefinitionId) } ?: return@any false
+            RoomFaceStatics.activeStaticAbilities(container, definition).any { ability ->
+                imposes(state, predicateEvaluator, ability, permanentId, controller!!)
+            }
+        }
+    }
+
+    private fun imposes(
+        state: GameState,
+        evaluator: PredicateEvaluator,
+        ability: StaticAbility,
+        sourceId: EntityId,
+        controllerId: EntityId,
+    ): Boolean = when (ability) {
+        is OpponentsMustAttackWithCreature -> true
+        is ConditionalStaticAbility ->
+            evaluator.conditions.evaluate(
+                state, ability.condition, EffectContext(sourceId = sourceId, controllerId = controllerId)
+            ) && imposes(state, evaluator, ability.ability, sourceId, controllerId)
+        is CompositeStaticAbility ->
+            ability.abilities.any { imposes(state, evaluator, it, sourceId, controllerId) }
+        else -> false
+    }
+}
