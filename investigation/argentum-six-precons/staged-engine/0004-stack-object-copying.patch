+        result.events.filterIsInstance<AbilityTriggeredEvent>().size shouldBe 0
+        result.events.filterIsInstance<AbilityActivatedEvent>().size shouldBe 0
+        result.events.filterIsInstance<AbilityCopiedEvent>().size shouldBe 1
+    }
