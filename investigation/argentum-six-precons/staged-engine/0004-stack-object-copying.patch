@@ -0,0 +1,21 @@
+package com.wingedsheep.sdk.scripting
+
+import com.wingedsheep.sdk.dsl.Effects
+import com.wingedsheep.sdk.scripting.effects.*
+import com.wingedsheep.sdk.scripting.references.Player
+import io.kotest.core.spec.style.FunSpec
+import io.kotest.matchers.shouldBe
+import kotlinx.serialization.json.Json
+
+class StackObjectCopySdkTest : FunSpec({
+    test("existing targeted-copy JSON still decodes and uses the same wire name") {
+        val original = Json.decodeFromString(Effect.serializer(), """{"type":"CopyEachTargetSpell"}""")
+        original shouldBe CopyStackObjectsEffect()
+        Json.encodeToString(Effect.serializer(), original).contains("CopyEachTargetSpell") shouldBe true
+    }
+    test("controlled stack copies round-trip with player and ability kinds") {
+        val effect = Effects.CopyControlledStackObjects(
+            setOf(StackObjectKind.ActivatedAbility, StackObjectKind.TriggeredAbility), Player.Opponent)
+        Json.decodeFromString(Effect.serializer(), Json.encodeToString(Effect.serializer(), effect)) shouldBe effect
+    }
+})
