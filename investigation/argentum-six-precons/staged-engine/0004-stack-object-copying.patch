+
+/** Engine fixtures isolate Ulalek's stack operation; they are not shipped card substitutes. */
+class StackObjectCopyEngineTest : FunSpec({
+    val life = card("Stack Copy Test Life") {
+        manaCost = "{1}"; typeLine = "Instant"
+        spell { effect = Effects.GainLife(1) }
+    }
+    val body = card("Stack Copy Test Body") {
+        manaCost = "{1}"; typeLine = "Creature — Eldrazi"; power = 2; toughness = 3
+    }
+    val redSource = card("Stack Copy Test Red Source") {
+        manaCost = "{R}"; typeLine = "Creature — Wizard"; power = 2; toughness = 3
+    }
+    val blueCopier = card("Stack Copy Test Blue Copier") {
+        manaCost = "{U}"; typeLine = "Creature — Wizard"; power = 2; toughness = 3
+    }
+    val guards = listOf(Color.RED, Color.BLUE).map { color -> card("Stack Copy ${color.name} Guard") {
+        manaCost = "{W}"; typeLine = "Creature — Soldier"; power = 2; toughness = 4
+        keywordAbility(KeywordAbility.Protection(ProtectionScope.Color(color)))
+    } }
+    val batch = CompositeEffect(listOf(
+        Effects.CopyControlledStackObjects(setOf(StackObjectKind.Spell)),
+        Effects.CopyControlledStackObjects(setOf(StackObjectKind.ActivatedAbility, StackObjectKind.TriggeredAbility))
+    ))
+    fun setup() = GameTestDriver().apply {
+        registerCards(TestCards.all + listOf(life, body, redSource, blueCopier) + guards)
+        initMirrorMatch(Deck.of("Island" to 40), startingPlayer = 0)
+        passPriorityUntil(Step.PRECOMBAT_MAIN)
+    }
+    fun cast(d: GameTestDriver, name: String = life.name): EntityId {
+        val id = d.putCardInHand(d.player1, name)
+        d.giveColorlessMana(d.player1, 1)
+        d.castSpell(d.player1, id).error shouldBe null
+        return id
+    }
+    fun triggered(d: GameTestDriver, source: EntityId, player: EntityId = d.player1,
+                  effect: Effect = Effects.GainLife(2), targets: List<ChosenTarget> = emptyList(),
+                  requirements: List<TargetRequirement> = emptyList()): EntityId {
+        val result = StackPlacement.putTriggeredAbility(d.state, TriggeredAbilityOnStackComponent(
+            source, "Test Source", player, effect, effect.description), targets, requirements)
+        d.replaceState(result.state)
+        return d.state.stack.last()
+    }
+    fun activated(d: GameTestDriver, source: EntityId, player: EntityId = d.player1): EntityId {
+        val result = StackPlacement.putActivatedAbility(d.state, ActivatedAbilityOnStackComponent(
+            source, "Test Source", player, Effects.GainLife(3), xValue = 7))
+        d.replaceState(result.state)
+        return d.state.stack.last()
+    }
+    fun execute(d: GameTestDriver, effect: Effect = batch, source: EntityId? = null): EffectResult {
+        val result = d.services.effectExecutorRegistry.execute(d.state, effect,
+            EffectContext(sourceId = source, controllerId = d.player1))
+        result.error shouldBe null
+        d.replaceState(result.state)
+        return result
+    }
+    fun order(d: GameTestDriver, firstToResolve: List<EntityId>) {
