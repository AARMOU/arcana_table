+package com.wingedsheep.engine.handlers.effects.stack
+
+import com.wingedsheep.engine.core.*
+import com.wingedsheep.engine.handlers.EffectContext
+import com.wingedsheep.engine.handlers.effects.EffectExecutor
+import com.wingedsheep.engine.handlers.effects.TargetResolutionUtils
+import com.wingedsheep.engine.state.GameState
+import com.wingedsheep.engine.state.isResolving
+import com.wingedsheep.engine.state.components.identity.CantBeCopiedComponent
+import com.wingedsheep.engine.state.components.identity.CardComponent
+import com.wingedsheep.engine.state.components.stack.*
+import com.wingedsheep.sdk.model.EntityId
+import com.wingedsheep.sdk.scripting.effects.*
+import com.wingedsheep.sdk.scripting.targets.EffectTarget
+import kotlin.reflect.KClass
+
+/** A batch is frozen before creating any copies; newly made copies cannot copy themselves. */
+class CopyStackObjectsExecutor(
+    private val executeEffect: (GameState, Effect, EffectContext) -> EffectResult
+) : EffectExecutor<CopyStackObjectsEffect> {
+    override val effectType: KClass<CopyStackObjectsEffect> = CopyStackObjectsEffect::class
+
+    override fun execute(state: GameState, effect: CopyStackObjectsEffect, context: EffectContext): EffectResult {
+        val controller = TargetResolutionUtils.resolvePlayerRef(effect.player, context, state)
+        val candidates = if (effect.source == StackCopySource.ChosenTargets)
+            context.targets.filterIsInstance<ChosenTarget.Spell>().map { it.spellEntityId }.distinct()
+        else state.stack.filter { id ->
+            val entity = state.getEntity(id)
+            val owner = entity?.get<SpellOnStackComponent>()?.casterId
+                ?: entity?.get<TriggeredAbilityOnStackComponent>()?.controllerId
+                ?: entity?.get<ActivatedAbilityOnStackComponent>()?.controllerId
+            owner == controller
+        }
+        val objects = candidates.filter { id ->
+            val e = state.getEntity(id) ?: return@filter false
+            val kind = when {
+                e.has<SpellOnStackComponent>() -> StackObjectKind.Spell
+                e.has<ActivatedAbilityOnStackComponent>() -> StackObjectKind.ActivatedAbility
+                e.has<TriggeredAbilityOnStackComponent>() -> StackObjectKind.TriggeredAbility
+                else -> return@filter false
+            }
+            kind in effect.kinds && !e.has<CantBeCopiedComponent>() &&
+                state.objectRef(id)?.let { !state.isResolving(it) } != false
+        }
+        if (objects.size < 2) return copyInOrder(state, objects, effect, context, executeEffect)
+        val info = objects.associateWith { id ->
+            val e = state.getEntity(id)!!
+            val abilityName = e.get<TriggeredAbilityOnStackComponent>()?.sourceName
+                ?: e.get<ActivatedAbilityOnStackComponent>()?.sourceName
+            val card = e.get<CardComponent>() ?: e.get<TriggeredAbilityOnStackComponent>()?.sourceId?.let {
+                state.getEntity(it)?.get<CardComponent>()
+            } ?: e.get<ActivatedAbilityOnStackComponent>()?.sourceId?.let { state.getEntity(it)?.get<CardComponent>() }
+            SearchCardInfo(name = e.get<CardComponent>()?.name ?: "$abilityName's ability",
+                manaCost = card?.manaCost?.toString() ?: "", typeLine = if (abilityName == null)
+                    card?.typeLine?.toString() ?: "Spell" else "Ability", imageUri = card?.imageUri)
+        }
+        return EffectResult.from(state.suspendForDecision({ id -> OrderObjectsDecision(
+            id = id, playerId = context.controllerId,
+            prompt = "Choose the stack order for the copies",
+            context = DecisionContext(phase = DecisionPhase.RESOLUTION),
+            objects = objects, cardInfo = info,
+            orderingTitle = "Order copies", firstLabel = "Resolves first", lastLabel = "Resolves last"
+        ) }, CopyStackObjectsOrderContinuation(objects, effect, context), emptyList()))
+    }
+
+    companion object {
+        /** [objects] is bottom-to-top: each ordinary copy is placed above the preceding one. */
+        fun copyInOrder(state: GameState, objects: List<EntityId>, effect: CopyStackObjectsEffect,
+                        context: EffectContext,
+                        executeEffect: (GameState, Effect, EffectContext) -> EffectResult): EffectResult {
+            val effects = objects.map { id ->
+                if (state.getEntity(id)?.has<SpellOnStackComponent>() == true)
+                    CopyTargetSpellEffect(EffectTarget.SpecificEntity(id),
+                        keywordsForCopy = effect.keywordsForCopy, removeLegendary = effect.removeLegendary)
+                else CopyTargetSpellOrAbilityEffect(EffectTarget.SpecificEntity(id))
+            }
+            return if (effects.isEmpty()) EffectResult.success(state)
+            else executeEffect(state, CompositeEffect(effects), context)
+        }
+    }
+}
