+    }
+    fun roundTrip(d: GameTestDriver) {
+        val json = Json { serializersModule = engineSerializersModule; allowStructuredMapKeys = true; encodeDefaults = true }
+        d.replaceState(json.decodeFromString(GameState.serializer(), json.encodeToString(GameState.serializer(), d.state)))
+    }
+
+    test("spells are copied before abilities, and each group may be freely ordered") {
+        val d = setup()
+        val source = d.putPermanentOnBattlefield(d.player1, redSource.name)
+        val spell = cast(d)
+        val a = triggered(d, source)
+        val b = activated(d, source)
+        val originalStack = d.state.stack
+        execute(d)
+        d.pendingDecision!!::class shouldBe OrderObjectsDecision::class
+        order(d, listOf(a, b))
+        val added = d.state.stack.drop(originalStack.size)
+        added.size shouldBe 3
+        d.state.getEntity(added[0])!!.has<SpellOnStackComponent>() shouldBe true
+        d.state.getEntity(added[1])!!.get<ActivatedAbilityOnStackComponent>()!!.xValue shouldBe 7
+        d.state.getEntity(added[2])!!.get<TriggeredAbilityOnStackComponent>()!!.sourceId shouldBe source
+        d.state.stack.take(originalStack.size) shouldBe originalStack
+        d.state.getEntity(added[0])!!.get<CopyOfComponent>()!!.originalCardDefinitionId shouldBe
+            d.state.getEntity(spell)!!.get<CardComponent>()!!.cardDefinitionId
+    }
