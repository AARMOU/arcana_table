+            val original = triggered(d, source, effect = Effects.DealDamage(1, EffectTarget.ContextTarget(0)),
+                targets = listOf(ChosenTarget.Permanent(old)), requirements = listOf(com.wingedsheep.sdk.scripting.targets.TargetObject(filter = TargetFilter.Creature)))
+            val stamp = d.state.getEntity(original)!!.get<TargetsComponent>()!!.targetEntryStamps.getValue(old)
+            d.replaceState(d.state.updateEntity(old) { it.with(BattlefieldEntryTimestampComponent(stamp + 100)) })
+            execute(d, Effects.CopyControlledStackObjects(setOf(StackObjectKind.TriggeredAbility)))
+            d.submitTargetSelection(d.player1, if (keep) emptyList() else listOf(old)).error shouldBe null
+            d.state.getEntity(d.state.stack.last())!!.get<TargetsComponent>()!!.targetEntryStamps[old] shouldBe
+                if (keep) stamp else stamp + 100
+        }
+    }
