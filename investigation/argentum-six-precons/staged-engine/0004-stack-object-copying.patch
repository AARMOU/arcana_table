+        val d = setup()
+        val source = d.putPermanentOnBattlefield(d.player1, redSource.name)
+        val copier = d.putPermanentOnBattlefield(d.player1, blueCopier.name)
+        val old = d.putPermanentOnBattlefield(d.player1, "Grizzly Bears")
