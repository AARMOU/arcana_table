+        val d = setup()
+        val source = d.putPermanentOnBattlefield(d.player1, redSource.name)
+        val own = triggered(d, source)
+        val opponent = triggered(d, source, d.player2)
+        val resolving = triggered(d, source, effect = batch)
+        val begun = d.state.beginResolutionControl(resolving)
+        d.replaceState(begun.state)
+        val result = execute(d, Effects.CopyControlledStackObjects(setOf(StackObjectKind.TriggeredAbility)))
