diff --git a/rules-engine/src/test/kotlin/com/wingedsheep/engine/handlers/mana/ColorlessHybridManaPaymentTest.kt b/rules-engine/src/test/kotlin/com/wingedsheep/engine/handlers/mana/ColorlessHybridManaPaymentTest.kt
