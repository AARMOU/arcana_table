@@ -28,6 +29,29 @@ import com.wingedsheep.engine.state.components.identity.faceUpCardDefinition
 class GrantedKeywordResolver(
     private val cardRegistry: CardRegistry
 ) {
+    /**
+     * Evaluates a grant's [GrantKeywordToOwnSpells.maxManaValue] for the grant's controller. Only
+     * consumers holding a dynamic-amount evaluator supply one (granted cascade in CastTriggers);
+     * without it a mana-value-capped grant fails closed.
+     */
+    fun interface ManaValueCap {
+        fun evaluate(state: GameState, amount: DynamicAmount, sourceId: EntityId, controllerId: EntityId): Int
+    }
+
+    /** The parts of a grant that depend on game state rather than on the spell's printed card. */
+    private fun grantActive(
+        state: GameState,
+        grant: GrantKeywordToOwnSpells,
+        sourceId: EntityId,
+        controllerId: EntityId,
+        castManaValue: () -> Int,
+        cap: ManaValueCap?
+    ): Boolean {
+        if (grant.duringYourTurnOnly && state.activePlayerId != controllerId) return false
+        val max = grant.maxManaValue ?: return true
+        return cap != null && castManaValue() <= cap.evaluate(state, max, sourceId, controllerId)
+    }
+
     /**
      * Does [cardDef], if cast by [playerId] in [state], effectively have [keyword]?
      *
