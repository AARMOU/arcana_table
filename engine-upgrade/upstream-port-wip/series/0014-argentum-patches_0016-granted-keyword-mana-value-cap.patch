@@ -335,6 +335,13 @@ data class GrantMayCastFromLinkedExile(
  * @property fromZone When set, only spells cast **from** this zone gain the keyword — "Spells you
  *   cast from exile have convoke" (Hoarding Broodlord) → `fromZone = Zone.EXILE`. The zone is the
  *   one the spell left when it was cast (CR 601.2a), not where it is now; null means any zone.
+ * @property maxManaValue When set, only spells whose mana value **as cast** (X included) is at most
+ *   this amount gain the keyword, evaluated for this permanent's controller when the spell is cast —
+ *   "spells you cast from your hand with mana value X or less have cascade, where X is the total
+ *   amount of life your opponents have lost this turn" (Abaddon the Despoiler). Only consumers that
+ *   can evaluate a dynamic amount honour it (granted cascade); every other consumer fails closed.
+ * @property duringYourTurnOnly When true, the grant applies only during its controller's turn
+ *   ("During your turn, …"). Same reading as [MayPlayCardsFromExile.duringYourTurnOnly].
  */
 @SerialName("GrantKeywordToOwnSpells")
 @Serializable
@@ -342,21 +349,26 @@ data class GrantKeywordToOwnSpells(
     val keyword: Keyword,
     val spellFilter: GameObjectFilter = GameObjectFilter.Creature,
     val keywordParameter: Int? = null,
-    val fromZone: Zone? = null
+    val fromZone: Zone? = null,
+    val maxManaValue: DynamicAmount? = null,
+    val duringYourTurnOnly: Boolean = false
 ) : StaticAbility {
     override val description: String = buildString {
-        append(
-            if (spellFilter == GameObjectFilter.Any) "Spells"
-            else "${spellFilter.description.replaceFirstChar { it.uppercase() }} spells"
-        )
+        if (duringYourTurnOnly) append("During your turn, ")
+        val subject = if (spellFilter == GameObjectFilter.Any) "spells"
+            else "${spellFilter.description} spells"
+        append(if (duringYourTurnOnly) subject else subject.replaceFirstChar { it.uppercase() })
         append(" you cast")
         fromZone?.let { append(" from ${it.displayName.lowercase()}") }
+        maxManaValue?.let { append(" with mana value ${it.description} or less") }
         append(" have ${keyword.displayName.lowercase()}")
         keywordParameter?.let { append(" $it") }
     }
     override fun applyTextReplacement(replacer: TextReplacer): StaticAbility {
         val newFilter = spellFilter.applyTextReplacement(replacer)
-        return if (newFilter !== spellFilter) copy(spellFilter = newFilter) else this
+        val newMax = maxManaValue?.applyTextReplacement(replacer)
+        return if (newFilter !== spellFilter || newMax !== maxManaValue)
+            copy(spellFilter = newFilter, maxManaValue = newMax) else this
     }
 }
 
