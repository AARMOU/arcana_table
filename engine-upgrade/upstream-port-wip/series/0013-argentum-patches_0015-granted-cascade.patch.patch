diff --git a/rules-engine/src/main/kotlin/com/wingedsheep/engine/handlers/actions/spell/CastTriggers.kt b/rules-engine/src/main/kotlin/com/wingedsheep/engine/handlers/actions/spell/CastTriggers.kt
index 835d974bd..0d4899a65 100644
--- a/rules-engine/src/main/kotlin/com/wingedsheep/engine/handlers/actions/spell/CastTriggers.kt
+++ b/rules-engine/src/main/kotlin/com/wingedsheep/engine/handlers/actions/spell/CastTriggers.kt
@@ -21,6 +21,7 @@ import com.wingedsheep.engine.state.components.stack.SpellOnStackComponent
 import com.wingedsheep.engine.state.components.stack.TriggeredAbilityOnStackComponent
 import com.wingedsheep.sdk.core.Keyword
 import com.wingedsheep.sdk.core.Zone
+import com.wingedsheep.sdk.dsl.Effects
 import com.wingedsheep.sdk.dsl.Patterns
 import com.wingedsheep.sdk.model.CardDefinition
 import com.wingedsheep.sdk.scripting.AbilityId
@@ -162,7 +163,24 @@ internal class CastTriggers(
         val storm = List(stormInstances(state, action, cardDef)) {
             selfTrigger(state, spell, "storm", copyEffect(spell, spellEffect, stormCount), "Storm — copy $name $stormCount time(s)")
         }
-        return conspire + casualty + replicate + storm
+        // Printed cascade is already authored as a self-cast trigger in each
+        // card definition; only synthesize *granted* instances here.
+        val grantedCascade = List(grantedCascadeInstances(state, action, cardDef)) {
+            selfTrigger(state, spell, "cascade_granted", Effects.Cascade, "Cascade")
+        }
+        return conspire + casualty + replicate + storm + grantedCascade
+    }
+
+    private fun grantedCascadeInstances(state: GameState, action: CastSpell, cardDef: CardDefinition): Int {
+        val grants = state.getEntity(action.playerId)?.get<GrantedSpellKeywordsComponent>()?.grants.orEmpty()
+        val context = PredicateContext(controllerId = action.playerId)
+        val emblems = grants.count { grant ->
+            grant.keyword == Keyword.CASCADE &&
+                predicateEvaluator.matches(state, state.projectedState, action.cardId, grant.spellFilter, context)
+        }
+        return emblems + grantedKeywordResolver.countGrants(
+            state, action.playerId, cardDef, Keyword.CASCADE, action.cardId
+        )
     }
 
     private fun stormInstances(state: GameState, action: CastSpell, cardDef: CardDefinition): Int {
diff --git a/rules-engine/src/main/kotlin/com/wingedsheep/engine/mechanics/mana/GrantedKeywordResolver.kt b/rules-engine/src/main/kotlin/com/wingedsheep/engine/mechanics/mana/GrantedKeywordResolver.kt
index c8f8d0af7..f99d04fa7 100644
--- a/rules-engine/src/main/kotlin/com/wingedsheep/engine/mechanics/mana/GrantedKeywordResolver.kt
+++ b/rules-engine/src/main/kotlin/com/wingedsheep/engine/mechanics/mana/GrantedKeywordResolver.kt
@@ -91,6 +91,7 @@ class GrantedKeywordResolver(
         val colors = state.projectedState.spellColors(playerId, cardDef.colors, spellId)
         findNextSpellRider(state, playerId, cardDef, keyword, colors)?.let { return it }
         val spellZone by lazy(LazyThreadSafetyMode.NONE) { castZone(state, spellId) }
+        val castManaValue by lazy(LazyThreadSafetyMode.NONE) { manaValueAtCast(state, spellId, cardDef) }
         for (permanentId in state.getBattlefield()) {
             val container = state.getEntity(permanentId) ?: continue
             val controllerId = container.get<ControllerComponent>()?.playerId ?: continue
@@ -99,7 +100,7 @@ class GrantedKeywordResolver(
             for (ability in sourceDef.script.staticAbilities) {
                 if (ability is GrantKeywordToOwnSpells &&
                     ability.keyword == keyword &&
-                    grantApplies(ability, cardDef, colors) { spellZone }
+                    grantApplies(ability, cardDef, colors, { spellZone }, { castManaValue })
                 ) {
                     return permanentId
                 }
@@ -124,6 +125,7 @@ class GrantedKeywordResolver(
         val colors = state.projectedState.spellColors(playerId, cardDef.colors, spellId)
         var count = state.pendingNextSpellKeywords.count { riderApplies(it, playerId, cardDef, keyword, colors) }
         val spellZone by lazy(LazyThreadSafetyMode.NONE) { castZone(state, spellId) }
+        val castManaValue by lazy(LazyThreadSafetyMode.NONE) { manaValueAtCast(state, spellId, cardDef) }
         for (permanentId in state.getBattlefield()) {
             val container = state.getEntity(permanentId) ?: continue
             val controllerId = container.get<ControllerComponent>()?.playerId ?: continue
@@ -132,7 +134,7 @@ class GrantedKeywordResolver(
             for (ability in sourceDef.script.staticAbilities) {
                 if (ability is GrantKeywordToOwnSpells &&
                     ability.keyword == keyword &&
-                    grantApplies(ability, cardDef, colors) { spellZone }
+                    grantApplies(ability, cardDef, colors, { spellZone }, { castManaValue })
                 ) {
                     count++
                 }
@@ -170,16 +172,34 @@ class GrantedKeywordResolver(
     /** [castZone] is only consulted by a zone-scoped grant, so the zone scan stays off the common path. */
     private inline fun grantApplies(grant: GrantKeywordToOwnSpells, cardDef: CardDefinition, colors: Set<Color>, castZone: () -> Zone?): Boolean =
         matchesSpellFilter(grant.spellFilter, cardDef, colors) && (grant.fromZone == null || grant.fromZone == castZone())
+    private inline fun grantApplies(
+        grant: GrantKeywordToOwnSpells,
+        cardDef: CardDefinition,
+        colors: Set<Color>,
+        castZone: () -> Zone?,
+        manaValue: () -> Int
+    ): Boolean = matchesSpellFilter(grant.spellFilter, cardDef, colors, manaValue()) &&
+        (grant.fromZone == null || grant.fromZone == castZone())
+
+    /** Account for the announced X on the stack when qualifying a keyword grant. */
+    private fun manaValueAtCast(state: GameState, spellId: EntityId?, cardDef: CardDefinition): Int {
+        val container = spellId?.let { state.getEntity(it) } ?: return cardDef.manaCost.cmc
+        val cost = container.get<CardComponent>()?.manaCost ?: return cardDef.manaCost.cmc
+        val x = container.get<SpellOnStackComponent>()?.xValue ?: 0
+        return cost.withXAs(x).cmc
+    }
 
     /**
      * Match a spell's [cardDef] against a [GameObjectFilter] using the card's printed
      * characteristics, except [colors]: the spell's actual ones (Mycosynth Lattice). Only a narrow set of predicates is supported because spells being cast
      * don't yet have battlefield state — the caller knows the card, not an entity.
      */
-    private fun matchesSpellFilter(filter: GameObjectFilter, cardDef: CardDefinition, colors: Set<Color>): Boolean {
+    private fun matchesSpellFilter(
+        filter: GameObjectFilter, cardDef: CardDefinition, colors: Set<Color>, manaValue: Int = cardDef.manaCost.cmc
+    ): Boolean {
         // GameObjectFilter.Any / empty predicates match everything.
         if (filter.cardPredicates.isEmpty() && filter.controllerPredicate == null) return true
-        return filter.cardPredicates.all { matchesPredicate(it, cardDef, colors) }
+        return filter.cardPredicates.all { matchesPredicate(it, cardDef, colors, manaValue) }
     }
 
     /**
@@ -188,11 +208,14 @@ class GrantedKeywordResolver(
      * [GameObjectFilter.InstantOrSorcery] (an `Or` of `IsInstant`/`IsSorcery`) resolve, which
      * is what "instant and sorcery spells you cast have storm" needs.
      */
-    private fun matchesPredicate(predicate: CardPredicate, cardDef: CardDefinition, colors: Set<Color>): Boolean =
+    private fun matchesPredicate(predicate: CardPredicate, cardDef: CardDefinition, colors: Set<Color>, manaValue: Int): Boolean =
         when (predicate) {
-            is CardPredicate.And -> predicate.predicates.all { matchesPredicate(it, cardDef, colors) }
-            is CardPredicate.Or -> predicate.predicates.any { matchesPredicate(it, cardDef, colors) }
-            is CardPredicate.Not -> !matchesPredicate(predicate.predicate, cardDef, colors)
+            is CardPredicate.And -> predicate.predicates.all { matchesPredicate(it, cardDef, colors, manaValue) }
+            is CardPredicate.Or -> predicate.predicates.any { matchesPredicate(it, cardDef, colors, manaValue) }
+            is CardPredicate.Not -> !matchesPredicate(predicate.predicate, cardDef, colors, manaValue)
+            is CardPredicate.ManaValueAtLeast -> manaValue >= predicate.min
+            is CardPredicate.ManaValueAtMost -> manaValue <= predicate.max
+            is CardPredicate.ManaValueEquals -> manaValue == predicate.value
             CardPredicate.IsCreature -> cardDef.typeLine.isCreature
             CardPredicate.IsNoncreature -> !cardDef.typeLine.isCreature
             CardPredicate.IsArtifact -> cardDef.typeLine.isArtifact
