+++ b/rules-engine/src/main/kotlin/com/wingedsheep/engine/mechanics/mana/AbilityPaymentContextBuilder.kt
@@ -42,6 +42,13 @@ internal fun buildAbilityPaymentContext(
     return SpellPaymentContext(
         isAbilityActivation = true,
         abilitySourceCardTypes = cardTypes,
+        // Battlefield color-changing effects are authoritative; other zones use printed
+        // characteristics because the layer projector does not project those entities.
+        isAbilitySourceColorless = if (sourceId in projected.getBaseState().getBattlefield()) {
+            projected.getColors(sourceId).isEmpty()
+        } else {
+            cardComponent.colors.isEmpty()
+        },
         isAbilitySourceOnBattlefield = sourceId in projected.getBaseState().getBattlefield(),
         subtypes = subtypes,
         isEquipAbilityActivation = ability?.isEquipAbility == true,
diff --git a/rules-engine/src/main/kotlin/com/wingedsheep/engine/mechanics/mana/ManaPool.kt b/rules-engine/src/main/kotlin/com/wingedsheep/engine/mechanics/mana/ManaPool.kt
index efdc2b31e..49fbcf4c4 100644
--- a/rules-engine/src/main/kotlin/com/wingedsheep/engine/mechanics/mana/ManaPool.kt
+++ b/rules-engine/src/main/kotlin/com/wingedsheep/engine/mechanics/mana/ManaPool.kt
@@ -59,6 +59,12 @@ data class SpellPaymentContext(
     val isAbilityActivation: Boolean = false,
     /** Card types of the source whose ability is being activated (empty for spell-cast contexts). */
     val abilitySourceCardTypes: Set<com.wingedsheep.sdk.core.CardType> = emptySet(),
+    /**
+     * True only when the activated ability's SOURCE is colorless in its current zone.
+     * Not interchangeable with [isColorless], which describes a spell being cast.
+     * Defaults to false so omitted source characteristics cannot spend restricted mana.
+     */
+    val isAbilitySourceColorless: Boolean = false,
     /** True when the source whose ability is being activated is a permanent on the battlefield. */
     val isAbilitySourceOnBattlefield: Boolean = false,
     /**
@@ -225,6 +231,10 @@ fun ManaRestriction.isSatisfiedBy(context: SpellPaymentContext): Boolean = when
     is ManaRestriction.ColorlessSpellsOnly -> context.isSpellCast && context.isColorless
     is ManaRestriction.ColoredSpellsOnly ->
         context.isSpellCast && (context.colorCount ?: 0) >= 1 && !(withoutXInCost && context.hasXInCost)
+    is ManaRestriction.ColorlessSubtypeSpellsOrAbilitiesOnly ->
+        context.subtypes.any { it.equals(subtype, ignoreCase = true) } &&
+            ((context.isSpellCast && context.isColorless) ||
+                (context.isAbilityActivation && context.isAbilitySourceColorless))
     is ManaRestriction.SpellsWithExactColorCount -> context.isSpellCast && context.colorCount == count
     is ManaRestriction.CostsContainingXOnly -> (context.isSpellCast || context.isAbilityActivation) && context.hasXInCost
     is ManaRestriction.SubtypeSpellsOrAbilitiesOnly ->
