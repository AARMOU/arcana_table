From 76beac2b5c7781a551939fdf12db664390308b94 Mon Sep 17 00:00:00 2001
From: arcana <a@a>
Date: Sat, 31 Oct 2026 20:23:08 -0600
Subject: [PATCH 8/9] 0008-jvm-test-toolchain.patch

---
 buildSrc/src/main/kotlin/kotlin-jvm.gradle.kts | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/buildSrc/src/main/kotlin/kotlin-jvm.gradle.kts b/buildSrc/src/main/kotlin/kotlin-jvm.gradle.kts
index 3374cddf8..9ade880ed 100644
--- a/buildSrc/src/main/kotlin/kotlin-jvm.gradle.kts
+++ b/buildSrc/src/main/kotlin/kotlin-jvm.gradle.kts
@@ -20,7 +20,6 @@ kotlin {
     // Arcana: compile against the Java 17 API so the jars run on Android (no Java 21-only calls).
     compilerOptions {
         jvmTarget.set(org.jetbrains.kotlin.gradle.dsl.JvmTarget.JVM_17)
-        freeCompilerArgs.add("-Xjdk-release=17")
     }
 }
 
@@ -37,6 +36,9 @@ val kotlinCompileThrottle =
 
 tasks.withType<KotlinCompile>().configureEach {
     usesService(kotlinCompileThrottle)
+    // Android runtime sources use Java 17. JVM-only tests run on the Java 21 toolchain
+    // and include existing benchmark utilities that use Thread.threadId().
+    if (!name.contains("Test")) compilerOptions.freeCompilerArgs.add("-Xjdk-release=17")
 }
 
 tasks.withType<Test>().configureEach {
