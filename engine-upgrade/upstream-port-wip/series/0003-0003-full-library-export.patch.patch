diff --git a/arcana-export/src/main/kotlin/com/arcanatable/export/ArcanaExport.kt b/arcana-export/src/main/kotlin/com/arcanatable/export/ArcanaExport.kt
index 3b9b6fa91..7b0b7e65a 100644
--- a/arcana-export/src/main/kotlin/com/arcanatable/export/ArcanaExport.kt
+++ b/arcana-export/src/main/kotlin/com/arcanatable/export/ArcanaExport.kt
@@ -1,26 +1,53 @@
 package com.arcanatable.export
 
+import com.wingedsheep.mtg.sets.MtgSetCatalog
+import com.wingedsheep.mtg.sets.basicLandsFallback
 import com.wingedsheep.mtg.sets.definitions.por.PortalSet
+import com.wingedsheep.mtg.sets.legality.LegalityData
+import com.wingedsheep.mtg.sets.tokens.PredefinedTokens
+import com.wingedsheep.sdk.model.CardDefinition
 import com.wingedsheep.sdk.tooling.CardExporter
 import com.wingedsheep.sdk.tooling.CardLoader
 import java.io.File
 
 /**
- * Writes Portal (POR) as card DATA for Arcana's in-app engine trial: one compact JSON definition
- * per line, exactly as Argentum's own CardExporter produces it, then reloads every line with
- * CardLoader.fromJsonPreservingIds to prove the round trip before anything ships.
+ * Writes Argentum's card library as DATA for Arcana's in-app engine: one compact JSON definition
+ * per line (Argentum's own CardExporter format) plus a matching index of names, in the same order
+ * and with the same stamping the game server applies when it builds its registry
+ * (GameBeansConfig.cardRegistry). Every line is reloaded with CardLoader.fromJsonPreservingIds
+ * before anything ships.
  */
 fun main(args: Array<String>) {
     val outDir = File(args.firstOrNull() ?: "arcana-export-out").apply { mkdirs() }
-    val cards = (PortalSet.cards + PortalSet.basicLands).distinctBy { it.name }
-    val lines = cards.map { CardExporter.exportToCompactJson(it).replace("\n", "") }
+    write(outDir, "por-cards", (PortalSet.cards + PortalSet.basicLands).distinctBy { it.name }.map { it to "card" })
+
+    val byName = LinkedHashMap<String, Pair<CardDefinition, String>>()
+    PredefinedTokens.allTokens.forEach { byName[it.name] = it to "token" }
+    for (set in MtgSetCatalog.all) {
+        set.cards.forEach { card ->
+            var c = if (card.setCode == null) card.copy(setCode = set.code) else card
+            if (c.metadata.releaseDate == null && set.releaseDate != null) c = c.copy(metadata = c.metadata.copy(releaseDate = set.releaseDate))
+            byName[c.name] = LegalityData.stamp(c) to "card"
+        }
+        set.basicLands.forEach { byName.putIfAbsent(it.name, LegalityData.stamp(it) to "basic") }
+        set.basicLandsFallback?.basicLands?.forEach { byName.putIfAbsent(it.name, LegalityData.stamp(it) to "basic") }
+    }
+    write(outDir, "all-cards", byName.values.toList())
+}
+
+private fun write(outDir: File, base: String, cards: List<Pair<CardDefinition, String>>) {
     var failures = 0
-    lines.zip(cards).forEach { (line, card) ->
-        val back = runCatching { CardLoader.fromJsonPreservingIds(line) }.getOrNull()
-        if (back == null || back.name != card.name) { failures++; System.err.println("Round trip failed: ${card.name}") }
+    val lines = ArrayList<String>(cards.size)
+    val index = StringBuilder()
+    for ((card, kind) in cards) {
+        val line = runCatching { CardExporter.exportToCompactJson(card).replace("\n", "") }.getOrNull()
+        val back = line?.let { runCatching { CardLoader.fromJsonPreservingIds(it) }.getOrNull() }
+        if (line == null || back == null || back.name != card.name) { failures++; System.err.println("Skipped (round trip failed): ${card.name}"); continue }
+        lines += line
+        index.append(card.name).append('\t').append(kind).append('\n')
     }
-    val out = File(outDir, "por-cards.jsonl")
+    val out = File(outDir, "$base.jsonl")
     out.writeText(lines.joinToString("\n") + "\n")
-    println("ARCANA-EXPORT cards=${cards.size} bytes=${out.length()} roundTripFailures=$failures file=${out.absolutePath}")
-    if (failures > 0) kotlin.system.exitProcess(2)
+    File(outDir, "$base.index.tsv").writeText(index.toString())
+    println("ARCANA-EXPORT $base cards=${lines.size} bytes=${out.length()} roundTripFailures=$failures")
 }
