 4 files changed, 46 insertions(+), 15 deletions(-)

diff --git a/ai/src/main/kotlin/com/wingedsheep/ai/engine/AIPlayer.kt b/ai/src/main/kotlin/com/wingedsheep/ai/engine/AIPlayer.kt
index 1c45f9f1f..1364f49de 100644
--- a/ai/src/main/kotlin/com/wingedsheep/ai/engine/AIPlayer.kt
+++ b/ai/src/main/kotlin/com/wingedsheep/ai/engine/AIPlayer.kt
@@ -70,11 +70,12 @@ class AIPlayer(
      * ~20-30 windows it crosses.
      */
     fun chooseAction(state: GameState): GameAction {
+        val decisionStartedNanos = System.nanoTime()
         if (useMeaningfulFilter && MeaningfulActionFilter.canAutoPassWithoutEnumerating(state, playerId)) {
             return PassPriority(playerId)
         }
         val legalActions = simulator.getLegalActions(state, playerId)
-        return chooseFrom(state, legalActions).action
+        return strategist.chooseAction(state, legalActions, playerId, decisionStartedNanos).action
     }
 
     /**
diff --git a/ai/src/main/kotlin/com/wingedsheep/ai/engine/Strategist.kt b/ai/src/main/kotlin/com/wingedsheep/ai/engine/Strategist.kt
index 58855ab07..c58920f16 100644
--- a/ai/src/main/kotlin/com/wingedsheep/ai/engine/Strategist.kt
+++ b/ai/src/main/kotlin/com/wingedsheep/ai/engine/Strategist.kt
@@ -302,7 +302,8 @@ class Strategist(
     fun chooseAction(
         state: GameState,
         legalActions: List<LegalAction>,
-        playerId: EntityId
+        playerId: EntityId,
+        decisionStartedNanos: Long? = null,
     ): LegalAction {
         val startNanos = if (insightSink != null) System.nanoTime() else 0L
         val forcedPlay = state.pendingDecision is com.wingedsheep.engine.core.PlayCardDecision
@@ -312,7 +313,9 @@ class Strategist(
         // returns a single DeclareAttackers/DeclareBlockers with an empty default map).
         val combatAction = legalActions.find { it.actionType == "DeclareAttackers" || it.actionType == "DeclareBlockers" }
         if (combatAction != null) {
-            val budget = budgetPolicy.budgetFor(state, playerId, listOf(combatAction))
+            val budget = budgetPolicy.budgetFor(state, playerId, listOf(combatAction)).let {
+                if (decisionStartedNanos != null) it.startingAt(decisionStartedNanos) else it
+            }
             return handleCombatDeclaration(evaluationState, combatAction, playerId, budget, startNanos)
         }
 
@@ -329,7 +332,10 @@ class Strategist(
             } else {
                 single
             }
-            return only.copy(action = chooseCommittedTargets(state, only, playerId))
+            val budget = budgetPolicy.budgetFor(state, playerId, listOf(only)).let {
+                if (decisionStartedNanos != null) it.startingAt(decisionStartedNanos) else it
+            }
+            return only.copy(action = chooseCommittedTargets(state, only, playerId, budget))
         }
 
         val pass = legalActions.find { it.actionType == "PassPriority" }
@@ -346,7 +352,10 @@ class Strategist(
 
         if (affordable.isEmpty()) return pass ?: legalActions.first()
 
-        val budget = budgetPolicy.budgetFor(state, playerId, affordable)
+        val budget = budgetPolicy.budgetFor(state, playerId, affordable).let {
+            if (decisionStartedNanos != null) it.startingAt(decisionStartedNanos) else it
+        }
+        if (budget.expired() && pass != null) return pass
         val here = StateProgress.digest(evaluationState)
 
         // ── Pass 1: one simulation per candidate, to the quiet state it leads to ──
@@ -378,6 +387,7 @@ class Strategist(
             }
         }
         for (action in affordable) {
+            if (budget.expired() && leaves.isNotEmpty()) break
             searched++
             val (materialized, materializedSimulation) = materialize(evaluationState, action, playerId, budget, here)
             // Only on failure, so a cast auto-pay can cover costs nothing extra.
@@ -1704,7 +1714,7 @@ class Strategist(
         if (TargetSelection.targetsAlreadyFilled(baseAction) != false) {
             return withSumGatedExilePayment(state, action, baseAction)
         }
-        if (!budget.allowances.refineTargetsBySimulation && !forceTargetRefinement) {
+        if (budget.expired() || (!budget.allowances.refineTargetsBySimulation && !forceTargetRefinement)) {
             return heuristicTargets(state, action, playerId)
         }
         val targetInfos = TargetSelection.fillableRequirements(action, useMeaningfulFilter)
@@ -1752,16 +1762,18 @@ class Strategist(
             if (forceTargetRefinement) maxOf(budget.allowances.targetCandidates, RESCUE_TARGET_CANDIDATES)
             else budget.allowances.targetCandidates
         for (i in targetInfos.indices) {
-            // A forced refinement ignores the clock: it runs only on the inert path, where the
-            // alternative is dropping an ability that may well have had a productive target.
-            if (budget.expired() && !forceTargetRefinement) break
+            // Rescue attempts share the decision deadline too; retain the heuristic pick on expiry.
+            if (budget.expired()) break
             val info = targetInfos[i]
             val priorIds = chosenTargetIds.take(i).toSet()
             val candidates = worth(i, info.validTargets.filterNot { info.mustDifferFromEarlier && it in priorIds })
                 .sortedByDescending(rankTarget)
                 .take(targetCandidates)
             if (candidates.size <= 1) continue
-            val best = candidates.maxByOrNull { candidate ->
+            var best: EntityId? = null
+            var bestScore = Double.NEGATIVE_INFINITY
+            for (candidate in candidates) {
+                if (budget.expired()) break
                 val trial = chosenTargets.toMutableList()
                 trial[i] = TargetSelection.toChosenTarget(state, info, candidate, playerId)
                 val result = simulator.simulate(state, TargetSelection.applyTargets(baseAction, trial))
@@ -1770,7 +1782,7 @@ class Strategist(
                 // below every real option, so `chooseAction` only ever drops the whole ability as
                 // inert when *no* target does anything. A target whose simulation never finished
                 // ranks there too, for the same reason: we cannot say what it does.
-                result.scoreOrRankLast { leaf ->
+                val score = result.scoreOrRankLast { leaf ->
                     if (StateProgress.digest(leaf) == here) {
                         Double.NEGATIVE_INFINITY
                     } else {
@@ -1778,9 +1790,14 @@ class Strategist(
                         if (recastBouncedPermanents) maxOf(direct, bestReplayOfBounced(state, leaf, playerId)) else direct
                     }
                 }
-            } ?: continue
-            chosenTargets[i] = TargetSelection.toChosenTarget(state, info, best, playerId)
-            chosenTargetIds[i] = best
+                if (best == null || score.compareTo(bestScore) > 0) {
+                    best = candidate
+                    bestScore = score
+                }
+            }
+            val selected = best ?: continue
+            chosenTargets[i] = TargetSelection.toChosenTarget(state, info, selected, playerId)
+            chosenTargetIds[i] = selected
         }
         // A lone optional slot ("up to one target creature") is a choice that includes *none*. When
         // the effect's side of the table can't be read, ask the simulation whether the best target
@@ -1795,7 +1812,7 @@ class Strategist(
                     .scoreOrRankLast { leaf -> evaluator.evaluate(leaf, leaf.projectedState, playerId) }
             }
             val skip = score(emptyList())
-            if (skip != Double.NEGATIVE_INFINITY && skip > score(chosenTargets)) {
+            if (!budget.expired() && skip != Double.NEGATIVE_INFINITY && skip > score(chosenTargets)) {
                 return withSumGatedExilePayment(state, action, TargetSelection.applyTargets(baseAction, emptyList()))
             }
         }
diff --git a/ai/src/main/kotlin/com/wingedsheep/ai/engine/budget/DecisionBudget.kt b/ai/src/main/kotlin/com/wingedsheep/ai/engine/budget/DecisionBudget.kt
index 4f3b8a25c..1e5deef9a 100644
--- a/ai/src/main/kotlin/com/wingedsheep/ai/engine/budget/DecisionBudget.kt
+++ b/ai/src/main/kotlin/com/wingedsheep/ai/engine/budget/DecisionBudget.kt
@@ -173,6 +173,9 @@ class DecisionBudget(
 
     fun expired(): Boolean = deadlineNanos != Long.MAX_VALUE && System.nanoTime() >= deadlineNanos
 
+    /** Include work already spent enumerating actions in this decision's deadline. */
+    fun startingAt(nanos: Long): DecisionBudget = DecisionBudget(tier, allowances, millis, nanos)
+
     fun remainingMs(): Long =
         if (deadlineNanos == Long.MAX_VALUE) Long.MAX_VALUE
         else max(0L, (deadlineNanos - System.nanoTime()) / NANOS_PER_MILLI)
diff --git a/ai/src/test/kotlin/com/wingedsheep/ai/engine/budget/DecisionBudgetTest.kt b/ai/src/test/kotlin/com/wingedsheep/ai/engine/budget/DecisionBudgetTest.kt
index 2235591ec..b900a5b3b 100644
--- a/ai/src/test/kotlin/com/wingedsheep/ai/engine/budget/DecisionBudgetTest.kt
+++ b/ai/src/test/kotlin/com/wingedsheep/ai/engine/budget/DecisionBudgetTest.kt
@@ -12,6 +12,16 @@ import io.kotest.matchers.shouldBe
  */
 class DecisionBudgetTest : FunSpec({
 
+    test("enumeration time is charged to the same decision deadline") {
+        val start = System.nanoTime() - 1_000_000_000L
+        val opened = DecisionBudget(BudgetTier.NORMAL, SearchAllowances.forMillis(150), 150)
+        val afterEnumeration = opened.startingAt(start)
+        afterEnumeration.deadlineNanos shouldBe start + 150_000_000L
+        afterEnumeration.expired() shouldBe true
+        afterEnumeration.remainingMs() shouldBe 0L
+        afterEnumeration.allowances shouldBe opened.allowances
+    }
+
     test("the NORMAL tier reproduces today's search counts exactly") {
         // If this ever fails, the permanent reference opponent has moved and every published
         // arena number is measured against a different baseline than it claims.
