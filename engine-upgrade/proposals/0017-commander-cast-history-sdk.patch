+package com.wingedsheep.engine.mana
+
+import com.wingedsheep.engine.handlers.EffectContext
+import com.wingedsheep.engine.handlers.PredicateEvaluator
+import com.wingedsheep.engine.state.ComponentContainer
+import com.wingedsheep.engine.state.GameState
+import com.wingedsheep.engine.state.ZoneKey
+import com.wingedsheep.engine.state.components.identity.CommanderComponent
+import com.wingedsheep.engine.state.components.identity.TokenComponent
+import com.wingedsheep.engine.support.GameTestDriver
+import com.wingedsheep.sdk.core.Color
+import com.wingedsheep.sdk.core.Format
+import com.wingedsheep.sdk.core.ManaCost
+import com.wingedsheep.sdk.core.Step
+import com.wingedsheep.sdk.core.Subtype
+import com.wingedsheep.sdk.core.Supertype
+import com.wingedsheep.sdk.model.CardDefinition
+import com.wingedsheep.sdk.model.Deck
+import io.kotest.matchers.shouldNotBe
+import com.wingedsheep.sdk.core.Zone
+import com.wingedsheep.sdk.dsl.DynamicAmounts
+import com.wingedsheep.sdk.model.EntityId
+import io.kotest.core.spec.style.FunSpec
+import io.kotest.matchers.shouldBe
+
+/** The new SDK amount reads committed commander history, including real accepted/rejected casts. */
+class CommanderCastHistoryAmountTest : FunSpec({
+    val players = List(4) { EntityId.generate() }
+    val amounts = PredicateEvaluator(cardRegistry = null).amounts
+    val history = DynamicAmounts.commanderCastsFromCommandZone()
+
+    fun emptyState(): GameState {
+        var state = GameState().copy(turnOrder = players)
+        for (player in players) state = state.withEntity(player, ComponentContainer.EMPTY)
+        return state
+    }
+
+    fun withCommander(
+        state: GameState,
+        owner: EntityId,
+        casts: Int,
+        zone: Zone = Zone.COMMAND,
+        token: Boolean = false,
+    ): GameState {
+        val id = EntityId.generate()
+        val container = if (token) {
+            ComponentContainer.of(CommanderComponent(owner, casts), TokenComponent)
+        } else {
+            ComponentContainer.of(CommanderComponent(owner, casts))
+        }
+        return state.withEntity(id, container).addToZone(ZoneKey(owner, zone), id)
+    }
+
+    fun read(state: GameState, player: EntityId): Int =
+        amounts.evaluate(state, history, EffectContext(sourceId = null, controllerId = player))
+
+    test("zero, first, second and third command-zone cast history reads the committed count") {
+        for (casts in 0..3) {
+            val state = withCommander(emptyState(), players[0], casts)
+            read(state, players[0]) shouldBe casts
+        }
+    }
+
+    test("partner commanders sum, but other players and other seats do not leak") {
+        var state = withCommander(emptyState(), players[0], 2)
+        state = withCommander(state, players[0], 3, Zone.HAND)
+        state = withCommander(state, players[1], 4, Zone.EXILE)
+        state = withCommander(state, players[2], 1, Zone.GRAVEYARD)
+        read(state, players[0]) shouldBe 5
+        read(state, players[1]) shouldBe 4
+        read(state, players[2]) shouldBe 1
+        read(state, players[3]) shouldBe 0
+    }
+
+    test("zone changes do not reset the history and token copies are not commanders") {
+        var state = withCommander(emptyState(), players[0], 3, Zone.GRAVEYARD)
+        state = withCommander(state, players[0], 8, Zone.BATTLEFIELD, token = true)
+        read(state, players[0]) shouldBe 3
+    }
+
+    test("no commander history yields zero rather than a color-identity count") {
+        read(emptyState(), players[0]) shouldBe 0
+    }
+
+    test("real rejected cast leaves history at zero, successful cast commits once and survives resolution") {
+        val commander = CardDefinition.creature(
+            name = "Cast History Commander",
+            manaCost = ManaCost.parse("{1}{W}"),
+            subtypes = setOf(Subtype("Human")),
+            power = 2,
+            toughness = 2,
+            supertypes = setOf(Supertype.LEGENDARY),
+        )
+        val filler = CardDefinition.creature(
+            name = "Cast History Filler",
+            manaCost = ManaCost.parse("{1}{W}"),
+            subtypes = setOf(Subtype("Human")),
+            power = 1,
+            toughness = 1,
+        )
+        val driver = GameTestDriver()
+        driver.registerCards(listOf(commander, filler))
+        val seats = driver.initMultiplayer(
+            decks = List(2) { Deck(cards = List(99) { filler.name }) },
+            format = Format.Commander(),
+            commanders = List(2) { commander.name },
+            skipMulligans = true,
+            startingPlayer = 0,
+        )
+        val owner = seats[0]
+        val opponent = seats[1]
+        val commanderId = driver.state.getZone(ZoneKey(owner, Zone.COMMAND)).single()
+        driver.passPriorityUntil(Step.PRECOMBAT_MAIN)
+        read(driver.state, owner) shouldBe 0
+        driver.castSpell(owner, commanderId).error shouldNotBe null // no mana: rejected
+        read(driver.state, owner) shouldBe 0
+        read(driver.state, opponent) shouldBe 0
+
+        driver.giveMana(owner, Color.WHITE, 1)
+        driver.giveColorlessMana(owner, 1)
+        driver.castSpell(owner, commanderId).error shouldBe null
+        read(driver.state, owner) shouldBe 1 // increment on cast commit, not resolution
+        read(driver.state, opponent) shouldBe 0
+        driver.bothPass()
+        read(driver.state, owner) shouldBe 1 // history persists after the spell resolves
+    }
+
+})
