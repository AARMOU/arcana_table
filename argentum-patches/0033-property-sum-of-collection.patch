diff --git a/rules-engine/src/test/kotlin/com/wingedsheep/engine/handlers/PropertySumOfCollectionTest.kt b/rules-engine/src/test/kotlin/com/wingedsheep/engine/handlers/PropertySumOfCollectionTest.kt
