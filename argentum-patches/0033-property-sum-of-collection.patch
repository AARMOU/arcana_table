@@ -0,0 +1,180 @@
+package com.wingedsheep.engine.handlers
+
+import com.wingedsheep.engine.core.SelectCardsDecision
+import com.wingedsheep.engine.state.components.battlefield.CountersComponent
+import com.wingedsheep.engine.support.GameTestDriver
+import com.wingedsheep.engine.support.TestCards
+import com.wingedsheep.sdk.core.Color
+import com.wingedsheep.sdk.core.CounterType
+import com.wingedsheep.sdk.core.Step
+import com.wingedsheep.sdk.dsl.DynamicAmounts
+import com.wingedsheep.sdk.dsl.Effects
+import com.wingedsheep.sdk.dsl.card
+import com.wingedsheep.sdk.model.Deck
+import com.wingedsheep.sdk.model.EntityId
+import com.wingedsheep.sdk.scripting.GameObjectFilter
+import com.wingedsheep.sdk.scripting.effects.Chooser
+import com.wingedsheep.sdk.scripting.references.Player
+import com.wingedsheep.sdk.scripting.values.CardNumericProperty
+import io.kotest.assertions.withClue
+import io.kotest.core.spec.style.FunSpec
+import io.kotest.matchers.nulls.shouldBeNull
+import io.kotest.matchers.shouldBe
+
+/**
+ * `DynamicAmount.PropertySumOfCollection`: the total projected power / toughness of exactly the
+ * creatures in a pipeline collection — here one creature *chosen* (not targeted) per opponent,
+ * the shape of Benthic Anomaly. Loop-collected collections survive the loop, so the sum sees every
+ * opponent's choice (a `StoreNumber` accumulator inside a for-each loop does not).
+ */
+class PropertySumOfCollectionTest : FunSpec({
+
+    val bear = card("Sum Test Bear") {
+        manaCost = "{1}{G}"
+        typeLine = "Creature — Bear"
+        power = 2
+        toughness = 2
+    }
+    val giant = card("Sum Test Giant") {
+        manaCost = "{3}{R}"
+        typeLine = "Creature — Giant"
+        power = 3
+        toughness = 4
+    }
+
+    /** "For each opponent, choose a creature that player controls. You gain life equal to their total power." */
+    val tally = card("Sum Test Tally") {
+        manaCost = "{U}"
+        typeLine = "Sorcery"
+        spell {
+            effect = Effects.Pipeline {
+                val chosen = forEachPlayerCollecting(Player.EachOpponent) {
+                    val theirs = gather(GameObjectFilter.Creature, player = Player.You)
+                    listOf(chooseExactly(1, from = theirs, chooser = Chooser.SourceController))
+                }.single()
+                run(Effects.GainLife(chosen.sumOf(CardNumericProperty.POWER)))
+            }
+        }
+    }
+
+    /** "… Create a token that's a copy of one of those creatures, except its P/T are their totals." */
+    val merge = card("Sum Test Merge") {
+        manaCost = "{U}"
+        typeLine = "Sorcery"
+        spell {
+            effect = Effects.Pipeline {
+                val chosen = forEachPlayerCollecting(Player.EachOpponent) {
+                    val theirs = gather(GameObjectFilter.Creature, player = Player.You)
+                    listOf(chooseExactly(1, from = theirs, chooser = Chooser.SourceController))
+                }.single()
+                val copied = chooseExactly(1, from = chosen, chooser = Chooser.Controller)
+                run(
+                    Effects.CreateTokenCopyOfTarget(
+                        target = copied.asTarget,
+                        basePower = chosen.sumOf(CardNumericProperty.POWER),
+                        baseToughness = DynamicAmounts.propertySumOf(chosen.key, CardNumericProperty.TOUGHNESS),
+                    )
+                )
+            }
+        }
+    }
+
+    fun driver(players: Int): Pair<GameTestDriver, List<EntityId>> {
+        val d = GameTestDriver()
+        d.registerCards(TestCards.all + listOf(bear, giant, tally, merge))
+        val ids = if (players == 2) {
+            d.initMirrorMatch(Deck.of("Forest" to 40))
+            listOf(d.player1, d.player2)
+        } else {
+            d.initMultiplayer(decks = List(players) { Deck.of("Forest" to 40) }).toList()
+        }
+        d.passPriorityUntil(Step.PRECOMBAT_MAIN, activePlayer = ids[0])
+        return d to ids
+    }
+
+    fun GameTestDriver.cast(you: EntityId, name: String) {
+        val spell = putCardInHand(you, name)
+        giveMana(you, Color.BLUE)
+        castSpell(you, spell).error.shouldBeNull()
+        passPriority(you)
+    }
+
+    fun GameTestDriver.drain(you: EntityId) {
+        var guard = 0
+        while (state.stack.isNotEmpty() && guard++ < 10) {
+            if (pendingDecision != null) return
+            passPriority(state.priorityPlayerId!!)
+        }
+    }
+
+    fun GameTestDriver.choose(you: EntityId, pick: EntityId) {
+        val decision = pendingDecision as? SelectCardsDecision
+        withClue("expected a selection prompt") { (decision != null) shouldBe true }
+        submitCardSelection(you, listOf(pick)).error.shouldBeNull()
+    }
+
+    test("three players: totals read both opponents' chosen creatures, projected (counters count)") {
+        val (d, ids) = driver(3)
+        val (you, foe1, foe2) = ids
+        val bear = d.putCreatureOnBattlefield(foe1, "Sum Test Bear")
+        d.putCreatureOnBattlefield(foe1, "Sum Test Giant")
+        val giant = d.putCreatureOnBattlefield(foe2, "Sum Test Giant")
+        d.replaceState(d.state.updateEntity(bear) { it.with(CountersComponent(mapOf(CounterType.PLUS_ONE_PLUS_ONE to 1))) })
+        val before = d.getLifeTotal(you)
+        d.cast(you, "Sum Test Tally")
+        d.drain(you)
+        d.choose(you, bear) // foe1 has two creatures; foe2's only creature is chosen for it
+        d.drain(you)
+        d.getLifeTotal(you) shouldBe before + 3 + 3 // bear 2 (+1 counter) + giant 3
+        d.state.projectedState.getPower(giant) shouldBe 3
+    }
+
+    test("an opponent with no creatures adds nothing") {
+        val (d, ids) = driver(3)
+        val (you, foe1, _) = ids
+        d.putCreatureOnBattlefield(foe1, "Sum Test Giant")
+        val before = d.getLifeTotal(you)
+        d.cast(you, "Sum Test Tally")
+        d.drain(you)
+        d.getLifeTotal(you) shouldBe before + 3
+    }
+
+    test("token copy: chosen original, P/T set to the totals; counters on the original are not copied") {
+        val (d, ids) = driver(3)
+        val (you, foe1, foe2) = ids
+        val bear = d.putCreatureOnBattlefield(foe1, "Sum Test Bear")
+        val giant = d.putCreatureOnBattlefield(foe2, "Sum Test Giant")
+        d.replaceState(d.state.updateEntity(giant) { it.with(CountersComponent(mapOf(CounterType.PLUS_ONE_PLUS_ONE to 2))) })
+        d.cast(you, "Sum Test Merge")
+        d.drain(you)
+        d.choose(you, bear) // which of the two chosen creatures to copy
+        d.drain(you)
+        val token = d.getCreatures(you).single()
+        d.state.projectedState.getPower(token) shouldBe 2 + 5
+        d.state.projectedState.getToughness(token) shouldBe 2 + 6
+        d.state.projectedState.hasSubtype(token, "Bear") shouldBe true
+    }
+
+    test("two players: the single chosen creature is copied with its own totals") {
+        val (d, ids) = driver(2)
+        val (you, foe) = ids
+        d.putCreatureOnBattlefield(foe, "Sum Test Giant")
+        d.cast(you, "Sum Test Merge")
+        d.drain(you)
+        val token = d.getCreatures(you).single()
+        d.state.projectedState.getPower(token) shouldBe 3
+        d.state.projectedState.getToughness(token) shouldBe 4
+    }
+
+    test("no opponent controls a creature: no token, sum is 0") {
+        val (d, ids) = driver(2)
+        val (you, _) = ids
+        val before = d.getLifeTotal(you)
+        d.cast(you, "Sum Test Tally")
+        d.drain(you)
+        d.getLifeTotal(you) shouldBe before
+        d.cast(you, "Sum Test Merge")
+        d.drain(you)
+        d.getCreatures(you).size shouldBe 0
+    }
+})
