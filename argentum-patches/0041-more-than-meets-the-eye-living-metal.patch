@@ -0,0 +1,23 @@
+package com.wingedsheep.sdk.dsl
+
+import com.wingedsheep.sdk.scripting.KeywordAbility
+
+/**
+ * Add More Than Meets the Eye [cost] (Transformers, CR 702.162).
+ *
+ * "You may cast this card converted by paying [cost] rather than its mana cost." (CR 702.162a)
+ * Belongs on the **front** face of a transforming double-faced card whose back face is a permanent.
+ *
+ * Display-only at the DSL layer — the behavior is the engine's alternative-cost pipeline, keyed off
+ * the [KeywordAbility.MoreThanMeetsTheEye] entry in `cardDef.keywordAbilities`. It is the hand (and
+ * command zone) sibling of [disturb]: the cast enumerators offer "cast <back face> (More Than Meets
+ * the Eye)" at the *back* face's timing, the cast handler charges [cost] instead of the mana cost and
+ * puts the card on the stack back face up (CR 712.8c), its mana value stays the front face's
+ * (CR 712.8e), and the permanent resolves converted (CR 712.13).
+ *
+ * "Convert" (CR 701.28) is the same physical action as transform for these cards, so a printed
+ * "convert ~" is `Effects.Transform(EffectTarget.Self)`.
+ */
+fun CardBuilder.moreThanMeetsTheEye(cost: String) {
+    keywordAbilityList.add(KeywordAbility.moreThanMeetsTheEye(cost))
+}
