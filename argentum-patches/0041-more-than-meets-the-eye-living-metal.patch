@@ -0,0 +1,34 @@
+package com.wingedsheep.engine.mechanics
+
+import com.wingedsheep.sdk.model.CardDefinition
+import com.wingedsheep.sdk.scripting.KeywordAbility
+
+/**
+ * Single source of truth for "can this card be cast converted with More Than Meets the Eye, at what
+ * cost, and as which face?" — used by the hand and command-zone cast enumerators, the cast zone
+ * resolver, the cost totaller and the cast handler.
+ *
+ * More Than Meets the Eye (CR 702.162a) is printed on the *front* face of a transforming
+ * double-faced card and means "You may cast this card converted by paying [cost] rather than its
+ * mana cost." It is the hand-side sibling of [DisturbCasts]:
+ *
+ *  - The resulting spell is **back face up** (CR 712.8c), so its characteristics — card types
+ *    (hence timing), targets, P/T, abilities — all come from [castFace]. Only the cost comes from
+ *    the front face's keyword, and the mana value stays the front face's (CR 712.8e).
+ *  - The back face must be a permanent for the cast to exist at all.
+ */
+object MoreThanMeetsTheEyeCasts {
+
+    /** The printed More Than Meets the Eye keyword on [cardDef], or null when it has none. */
+    fun printed(cardDef: CardDefinition?): KeywordAbility.MoreThanMeetsTheEye? =
+        cardDef?.keywordAbilities?.filterIsInstance<KeywordAbility.MoreThanMeetsTheEye>()?.firstOrNull()
+
+    /**
+     * The face a converted cast of [cardDef] puts on the stack — its back face — or null when
+     * [cardDef] has no More Than Meets the Eye keyword or no permanent back face.
+     */
+    fun castFace(cardDef: CardDefinition?): CardDefinition? {
+        if (printed(cardDef) == null) return null
+        return cardDef?.backFace?.takeIf { it.isPermanent }
+    }
+}
