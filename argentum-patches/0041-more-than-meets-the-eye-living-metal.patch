+++ b/rules-engine/src/main/kotlin/com/wingedsheep/engine/legalactions/enumerators/MoreThanMeetsTheEyeOffers.kt
@@ -0,0 +1,142 @@
+package com.wingedsheep.engine.legalactions.enumerators
+
+import com.wingedsheep.engine.core.AlternativeCostType
+import com.wingedsheep.engine.core.CastSpell
+import com.wingedsheep.engine.handlers.TargetingSourceType
+import com.wingedsheep.engine.legalactions.EnumerationContext
+import com.wingedsheep.engine.legalactions.LegalAction
+import com.wingedsheep.engine.legalactions.surfacedRequirements
+import com.wingedsheep.engine.mechanics.MoreThanMeetsTheEyeCasts
+import com.wingedsheep.engine.mechanics.mana.spellPaymentContextFor
+import com.wingedsheep.engine.state.components.identity.CardComponent
+import com.wingedsheep.sdk.core.Keyword
+import com.wingedsheep.sdk.core.Zone
+import com.wingedsheep.sdk.model.CardDefinition
+import com.wingedsheep.sdk.model.EntityId
+
+/**
+ * The "cast converted" offer for a card with More Than Meets the Eye (CR 702.162a), from the hand
+ * or — for a commander — the command zone.
+ *
+ * Deliberately the same shape as `CastFromZoneEnumerator.enumerateDisturb`, because it is the same
+ * engine path from another zone: the card goes on the stack **back face up**, so everything except
+ * the cost is read off the back face — its card types decide the timing (a Vehicle back face is
+ * sorcery-speed unless it has flash), its targets decide what must be chosen, and its name labels
+ * the offer. The cost is the front face's printed keyword cost, run through the same cost-modifier
+ * pipeline as any cast of this card (so commander tax applies from the command zone).
+ *
+ * The callers have already applied the whole-card gates (`cantCastSpell`, the front face's
+ * `castRestrictions`) for the normal cast of this card; they are re-checked here only where the
+ * caller skips the card entirely.
+ */
+internal object MoreThanMeetsTheEyeOffers {
+
+    const val ACTION_TYPE = "CastConverted"
+
+    fun offer(
+        context: EnumerationContext,
+        cardId: EntityId,
+        cardDef: CardDefinition,
+        cardComponent: CardComponent,
+        fromZone: Zone,
+        result: MutableList<LegalAction>,
+    ) {
+        val printed = MoreThanMeetsTheEyeCasts.printed(cardDef) ?: return
+        val backFace = MoreThanMeetsTheEyeCasts.castFace(cardDef) ?: return
+        val state = context.state
+        val playerId = context.playerId
+
+        val hasFlash = backFace.keywords.contains(Keyword.FLASH) ||
+            context.castPermissionUtils.hasGrantedFlash(state, cardId, playerId)
+        if (!backFace.typeLine.isInstant && !hasFlash && !context.canPlaySorcerySpeed) return
+        if (context.cantCastSpell(cardId)) return
+        if (!context.legality.castRestrictionsMet(state, playerId, cardDef.script.castRestrictions)) return
+
+        val description = "Cast ${backFace.name} (More Than Meets the Eye)"
+        val action = CastSpell(
+            playerId, cardId,
+            useAlternativeCost = true,
+            alternativeCostType = AlternativeCostType.MORE_THAN_MEETS_THE_EYE,
+        )
+        val zoneName = fromZone.name
+
+        val pricing = context.costCalculator.priceByTargets(
+            state, cardDef, playerId, cardId, baseCost = printed.cost, withTable = !context.skipAutoTapPreview,
+            fromZone = fromZone,
+        )
+        val effectiveCost = pricing.min
+        val costString = effectiveCost.toString()
+        val costByTargetCount = pricing.byCountStrings()
+        val spellContext = spellPaymentContextFor(
+            cardComponent, colors = state.projectedState.colorSetOf(cardId), isFromHand = fromZone == Zone.HAND,
+        )
+        val canAfford = context.manaSolver.canPay(
+            state, playerId, effectiveCost, precomputedSources = context.availableManaSources, spellContext = spellContext,
+        )
+        if (!canAfford) {
+            result.add(
+                LegalAction(
+                    actionType = ACTION_TYPE,
+                    description = description,
+                    action = action,
+                    affordable = false,
+                    manaCostString = costString,
+                    manaCostByTargetCount = costByTargetCount,
+                    sourceZone = zoneName,
+                    castsTransformed = true,
+                )
+            )
+            return
+        }
+
+        val targetReqs = buildList {
+            addAll(backFace.script.targetRequirements)
+            backFace.script.castAuraTarget?.let { add(it) }
+        }
+        val autoTapPreview = if (context.skipAutoTapPreview) null else {
+            context.manaSolver.solve(
+                state, playerId, effectiveCost, precomputedSources = context.availableManaSources, spellContext = spellContext,
+            )?.sources?.map { it.entityId }
+        }
+        if (targetReqs.isEmpty()) {
+            result.add(
+                LegalAction(
+                    actionType = ACTION_TYPE,
+                    description = description,
+                    action = action,
+                    manaCostString = costString,
+                    manaCostByTargetCount = costByTargetCount,
+                    autoTapPreview = autoTapPreview,
+                    sourceZone = zoneName,
+                    castsTransformed = true,
+                )
+            )
+            return
+        }
+        val targetInfos = context.targetUtils.buildTargetInfos(
+            state, playerId, targetReqs, targetingSourceType = TargetingSourceType.SPELL,
+            spellSubtypes = backFace.typeLine.subtypes.mapTo(mutableSetOf()) { it.value },
+        )
+        if (!context.targetUtils.allRequirementsSatisfied(targetInfos)) return
+        val firstReq = targetReqs.first()
+        val firstInfo = targetInfos.first()
+        result.add(
+            LegalAction(
+                actionType = ACTION_TYPE,
+                description = description,
+                action = action,
+                validTargets = firstInfo.validTargets,
+                requiresTargets = true,
+                targetCount = firstInfo.maxTargets,
+                minTargets = firstReq.effectiveMinCount,
+                targetDescription = firstReq.description,
+                targetRequirements = targetInfos.surfacedRequirements(),
+                manaCostString = costString,
+                manaCostByTargetCount = costByTargetCount,
+                autoTapPreview = autoTapPreview,
+                sourceZone = zoneName,
+                castsTransformed = true,
+            )
+        )
+    }
+}
