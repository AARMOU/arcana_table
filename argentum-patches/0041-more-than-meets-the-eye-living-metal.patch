+ * (CR 603.12) depends on the transform having happened, e.g. Ratchet, Field Medic's "you may convert
+ * Ratchet. When you do, …": a second simultaneous trigger finds Ratchet already converted
+ * (CR 701.28f) and must neither convert it back nor fire its reflexive payoff.
+ */
+internal fun transformWouldHappen(
+    state: GameState,
+    effect: TransformEffect,
+    context: EffectContext,
+): Boolean {
+    val targetId = context.resolveTarget(effect.target) ?: return false
+    val container = state.getEntity(targetId) ?: return false
+    val projected = state.projectedState
+    if (projected.hasKeyword(targetId, Keyword.DAYBOUND) || projected.hasKeyword(targetId, Keyword.NIGHTBOUND)) return false
+    if (targetId == context.sourceId &&
+        context.sourceFaceChanges != null &&
+        context.sourceFaceChanges != container.get<DoubleFacedComponent>()?.faceChanges
+    ) return false
+    if (projected.hasKeyword(targetId, AbilityFlag.CANT_TRANSFORM)) return false
+    return container.get<DoubleFacedComponent>() != null && container.get<CardComponent>() != null
+}
