@@ -0,0 +1,29 @@
+package com.wingedsheep.sdk.dsl
+
+import com.wingedsheep.sdk.core.Keyword
+import com.wingedsheep.sdk.scripting.ConditionalStaticAbility
+import com.wingedsheep.sdk.scripting.GrantCardType
+import com.wingedsheep.sdk.scripting.filters.unified.GroupFilter
+
+/**
+ * Add Living metal (Transformers / The Brothers' War, CR 702.161).
+ *
+ * "As long as it's your turn, this permanent is also a creature." (CR 702.161a)
+ *
+ * Wires the whole keyword from one call: the [Keyword.LIVING_METAL] keyword (display and keyword
+ * queries) and a layer-4 type-adding static — [GrantCardType] `CREATURE` on the source, gated by
+ * [Conditions.IsYourTurn] — so the permanent is a creature exactly during its controller's turns.
+ * Being an ordinary static ability of the permanent, it stops applying when the permanent loses its
+ * abilities, and it is evaluated relative to the current controller (a stolen Vehicle is a creature
+ * on its new controller's turn). The printed power/toughness of the Vehicle face is what the
+ * creature has.
+ */
+fun CardBuilder.livingMetal() {
+    keywords(Keyword.LIVING_METAL)
+    staticAbilities.add(
+        ConditionalStaticAbility(
+            ability = GrantCardType("CREATURE", GroupFilter.source()),
+            condition = Conditions.IsYourTurn,
+        )
+    )
+}
