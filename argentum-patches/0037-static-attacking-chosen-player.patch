diff --git a/rules-engine/src/test/kotlin/com/wingedsheep/engine/mechanics/layers/AttackingChosenPlayerStaticTest.kt b/rules-engine/src/test/kotlin/com/wingedsheep/engine/mechanics/layers/AttackingChosenPlayerStaticTest.kt
new file mode 100644
index 00000000000..a21e23055c4
--- /dev/null
+++ b/rules-engine/src/test/kotlin/com/wingedsheep/engine/mechanics/layers/AttackingChosenPlayerStaticTest.kt
@@ -0,0 +1,137 @@
+package com.wingedsheep.engine.mechanics.layers
+
+import com.wingedsheep.engine.state.components.battlefield.ChoiceValue
+import com.wingedsheep.engine.state.components.battlefield.withCastChoice
+import com.wingedsheep.engine.state.components.combat.AttackingComponent
+import com.wingedsheep.engine.support.GameTestDriver
+import com.wingedsheep.engine.support.TestCards
+import com.wingedsheep.sdk.core.Keyword
+import com.wingedsheep.sdk.dsl.card
+import com.wingedsheep.sdk.model.Deck
+import com.wingedsheep.sdk.model.EntityId
+import com.wingedsheep.sdk.scripting.ChoiceSlot
+import com.wingedsheep.sdk.scripting.GameObjectFilter
+import com.wingedsheep.sdk.scripting.GrantKeyword
+import com.wingedsheep.sdk.scripting.filters.unified.GroupFilter
+import com.wingedsheep.sdk.scripting.references.Player
+import com.wingedsheep.sdk.scripting.targets.EffectTarget
+import io.kotest.assertions.withClue
+import io.kotest.core.spec.style.FunSpec
+import io.kotest.matchers.shouldBe
+
+/**
+ * `StatePredicate.IsAttackingPlayer` inside a static ability's group filter: during projection the
+ * player reference resolves against the static's *source* — its stored chosen opponent / chosen
+ * player, or its controller — so "creatures attacking the last chosen player have menace" (Triarch
+ * Stalker) projects. Only an attacker whose declared defender is that player matches: a
+ * planeswalker that player controls is a different defender. Trigger-bound references still fail
+ * closed here (no trigger context during projection).
+ */
+class AttackingChosenPlayerStaticTest : FunSpec({
+
+    val relay = card("Test Targeting Relay") {
+        manaCost = "{3}"
+        typeLine = "Artifact"
+        oracleText = "Creatures attacking the chosen player have menace."
+        staticAbility {
+            ability = GrantKeyword(
+                Keyword.MENACE,
+                GroupFilter(GameObjectFilter.Creature.attackingPlayer(EffectTarget.PlayerRef(Player.ChosenOpponent)))
+            )
+        }
+    }
+
+    val triggerBound = card("Test Trigger-Bound Relay") {
+        manaCost = "{3}"
+        typeLine = "Artifact"
+        oracleText = "Creatures attacking that player have menace."
+        staticAbility {
+            ability = GrantKeyword(
+                Keyword.MENACE,
+                GroupFilter(GameObjectFilter.Creature.attackingPlayer(EffectTarget.PlayerRef(Player.TriggeringPlayer)))
+            )
+        }
+    }
+
+    val walker = card("Test Relay Walker") {
+        manaCost = "{3}"
+        typeLine = "Legendary Planeswalker — Test"
+        startingLoyalty = 3
+        oracleText = ""
+    }
+
+    data class Table(val d: GameTestDriver, val p1: EntityId, val p2: EntityId, val p3: EntityId)
+
+    fun table(): Table {
+        val d = GameTestDriver()
+        d.registerCards(TestCards.all)
+        d.registerCards(listOf(relay, triggerBound, walker))
+        val (p1, p2, p3) = d.initMultiplayer(decks = List(3) { Deck.of("Forest" to 40) })
+        return Table(d, p1, p2, p3)
+    }
+
+    fun GameTestDriver.choose(source: EntityId, player: EntityId) =
+        replaceState(state.updateEntity(source) { it.withCastChoice(ChoiceSlot.OPPONENT, ChoiceValue.EntityChoice(player)) })
+
+    fun GameTestDriver.attack(creature: EntityId, defender: EntityId) =
+        replaceState(state.updateEntity(creature) { it.with(AttackingComponent(defenderId = defender)) })
+
+    fun GameTestDriver.menace(id: EntityId) = state.projectedState.hasKeyword(id, Keyword.MENACE)
+
+    test("attackers of the chosen player have it, whoever controls them; others don't") {
+        val (d, p1, p2, p3) = table()
+        val source = d.putPermanentOnBattlefield(p1, "Test Targeting Relay")
+        d.choose(source, p2)
+        val mine = d.putCreatureOnBattlefield(p1, "Centaur Courser")
+        val theirs = d.putCreatureOnBattlefield(p3, "Centaur Courser")
+        val atP3 = d.putCreatureOnBattlefield(p1, "Goblin Guide")
+        val idle = d.putCreatureOnBattlefield(p1, "Savannah Lions")
+        d.attack(mine, p2)
+        d.attack(theirs, p2)
+        d.attack(atP3, p3)
+
+        withClue("controller's attacker of the chosen player") { d.menace(mine) shouldBe true }
+        withClue("another opponent's attacker of the chosen player") { d.menace(theirs) shouldBe true }
+        withClue("attacker of a different player") { d.menace(atP3) shouldBe false }
+        withClue("non-attacker") { d.menace(idle) shouldBe false }
+    }
+
+    test("an attacker of the chosen player's planeswalker doesn't match") {
+        val (d, p1, p2, _) = table()
+        val source = d.putPermanentOnBattlefield(p1, "Test Targeting Relay")
+        d.choose(source, p2)
+        val pw = d.putPermanentOnBattlefield(p2, "Test Relay Walker")
+        val bear = d.putCreatureOnBattlefield(p1, "Goblin Guide")
+        d.attack(bear, pw)
+        d.menace(bear) shouldBe false
+    }
+
+    test("no chosen player — nothing matches; re-choosing moves it") {
+        val (d, p1, p2, p3) = table()
+        val source = d.putPermanentOnBattlefield(p1, "Test Targeting Relay")
+        val a = d.putCreatureOnBattlefield(p1, "Goblin Guide")
+        val b = d.putCreatureOnBattlefield(p1, "Centaur Courser")
+        d.attack(a, p2)
+        d.attack(b, p3)
+        withClue("nothing chosen yet") {
+            d.menace(a) shouldBe false
+            d.menace(b) shouldBe false
+        }
+        d.choose(source, p2)
+        d.menace(a) shouldBe true
+        d.menace(b) shouldBe false
+        d.choose(source, p3)
+        withClue("the last choice replaces the previous one") {
+            d.menace(a) shouldBe false
+            d.menace(b) shouldBe true
+        }
+    }
+
+    test("a trigger-bound player reference still fails closed in projection") {
+        val (d, p1, p2, _) = table()
+        d.putPermanentOnBattlefield(p1, "Test Trigger-Bound Relay")
+        val bear = d.putCreatureOnBattlefield(p1, "Goblin Guide")
+        d.attack(bear, p2)
+        d.menace(bear) shouldBe false
+    }
+})
