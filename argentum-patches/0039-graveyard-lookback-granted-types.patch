index 0000000000..41e0f894d6
--- /dev/null
+++ b/rules-engine/src/test/kotlin/com/wingedsheep/engine/mechanics/layers/GraveyardLookBackCardTypeTest.kt
@@ -0,0 +1,181 @@
+package com.wingedsheep.engine.mechanics.layers
+
+import com.wingedsheep.engine.core.CastSpell
+import com.wingedsheep.engine.core.PaymentStrategy
+import com.wingedsheep.engine.state.components.stack.ChosenTarget
+import com.wingedsheep.engine.support.GameTestDriver
+import com.wingedsheep.engine.support.TestCards
+import com.wingedsheep.sdk.core.Color
+import com.wingedsheep.sdk.core.Step
+import com.wingedsheep.sdk.core.Zone
+import com.wingedsheep.sdk.dsl.Effects
+import com.wingedsheep.sdk.dsl.Triggers
+import com.wingedsheep.sdk.dsl.card
+import com.wingedsheep.sdk.model.Deck
+import com.wingedsheep.sdk.model.EntityId
+import com.wingedsheep.sdk.scripting.GameObjectFilter
+import com.wingedsheep.sdk.scripting.GrantCardType
+import com.wingedsheep.sdk.scripting.filters.unified.GroupFilter
+import com.wingedsheep.sdk.scripting.filters.unified.TargetFilter
+import io.kotest.core.spec.style.FunSpec
+import io.kotest.matchers.shouldBe
+
+/**
+ * "Whenever one or more artifact cards leave your graveyard" looks back in time (CR 603.10a), so a
+ * creature card that a cross-zone [GrantCardType] made an artifact *in the graveyard* (Biotransference:
+ * "creature cards you own that aren't on the battlefield" are artifacts) counts, wherever it went.
+ * `GameState.removeFromZone` freezes the granted types onto the card as it leaves the graveyard and
+ * the leave-graveyard batch detector reads them. "Put into your graveyard" batches read the card
+ * as it now is in the graveyard, grant included.
+ *
+ * Pins: granted creature card leaving fires; the same card without a grant doesn't; a
+ * battlefield-only grant doesn't reach the graveyard; an opponent's grant doesn't reach your
+ * cards; a granted creature card put into your graveyard fires the arrival batch.
+ */
+class GraveyardLookBackCardTypeTest : FunSpec({
+
+    val creatureGrant = card("Test Biotransference") {
+        manaCost = "{2}{B}{B}"
+        typeLine = "Enchantment"
+        staticAbility {
+            ability = GrantCardType(
+                cardType = "ARTIFACT",
+                filter = GroupFilter(GameObjectFilter.Creature.youControl()),
+                includeControlledSpells = true,
+                includeOwnedCardsOutsideBattlefield = true
+            )
+        }
+    }
+
+    val battlefieldOnlyGrant = card("Test Battlefield Biotransference") {
+        manaCost = "{2}{B}{B}"
+        typeLine = "Enchantment"
+        staticAbility {
+            ability = GrantCardType(
+                cardType = "ARTIFACT",
+                filter = GroupFilter(GameObjectFilter.Creature.youControl())
+            )
+        }
+    }
+
+    val leaveWatcher = card("Test Artifact Leave Watcher") {
+        manaCost = "{1}"
+        typeLine = "Enchantment"
+        triggeredAbility {
+            trigger = Triggers.oneOrMore(GameObjectFilter.Artifact).leaveYourGraveyard()
+            effect = Effects.GainLife(1)
+        }
+    }
+
+    val arrivalWatcher = card("Test Artifact Arrival Watcher") {
+        manaCost = "{1}"
+        typeLine = "Enchantment"
+        triggeredAbility {
+            trigger = Triggers.oneOrMore(GameObjectFilter.Artifact).putIntoYourGraveyard()
+            effect = Effects.GainLife(1)
+        }
+    }
+
+    val raise = card("Test Raise") {
+        manaCost = "{B}"
+        typeLine = "Sorcery"
+        spell {
+            val target = target(TargetFilter.CreatureInYourGraveyard)
+            effect = Effects.Move(target, Zone.HAND)
+        }
+    }
+
+    fun newDriver(): GameTestDriver {
+        val driver = GameTestDriver()
+        driver.registerCards(
+            TestCards.all + listOf(creatureGrant, battlefieldOnlyGrant, leaveWatcher, arrivalWatcher, raise)
+        )
+        driver.initMirrorMatch(deck = Deck.of("Forest" to 40), skipMulligans = true, startingPlayer = 0)
+        driver.passPriorityUntil(Step.PRECOMBAT_MAIN)
+        return driver
+    }
+
+    fun GameTestDriver.raise(player: EntityId, target: EntityId) {
+        val spell = putCardInHand(player, "Test Raise")
+        giveMana(player, Color.BLACK, 1)
+        submit(
+            CastSpell(
+                playerId = player,
+                cardId = spell,
+                targets = listOf(ChosenTarget.Card(target, player, Zone.GRAVEYARD)),
+                paymentStrategy = PaymentStrategy.FromPool,
+            )
+        ).error shouldBe null
+        bothPass()
+        // Resolve the watcher's trigger, if any.
+        bothPass()
+    }
+
+    test("a granted-artifact creature card leaving your graveyard fires a leave-graveyard artifact watcher") {
+        val driver = newDriver()
+        val me = driver.player1
+        driver.putPermanentOnBattlefield(me, "Test Biotransference")
+        driver.putPermanentOnBattlefield(me, "Test Artifact Leave Watcher")
+        val corpse = driver.putCardInGraveyard(me, "Centaur Courser")
+        val life = driver.getLifeTotal(me)
+
+        driver.raise(me, corpse)
+
+        driver.getLifeTotal(me) shouldBe life + 1
+    }
+
+    test("without a grant a creature card leaving your graveyard is not an artifact card") {
+        val driver = newDriver()
+        val me = driver.player1
+        driver.putPermanentOnBattlefield(me, "Test Artifact Leave Watcher")
+        val corpse = driver.putCardInGraveyard(me, "Centaur Courser")
+        val life = driver.getLifeTotal(me)
+
+        driver.raise(me, corpse)
+
+        driver.getLifeTotal(me) shouldBe life
+    }
+
+    test("a battlefield-only grant does not reach the card in the graveyard") {
+        val driver = newDriver()
+        val me = driver.player1
+        driver.putPermanentOnBattlefield(me, "Test Battlefield Biotransference")
+        driver.putPermanentOnBattlefield(me, "Test Artifact Leave Watcher")
+        val corpse = driver.putCardInGraveyard(me, "Centaur Courser")
+        val life = driver.getLifeTotal(me)
+
+        driver.raise(me, corpse)
+
+        driver.getLifeTotal(me) shouldBe life
+    }
+
+    test("an opponent's grant does not make your creature cards artifacts") {
+        val driver = newDriver()
+        val me = driver.player1
+        driver.putPermanentOnBattlefield(driver.player2, "Test Biotransference")
+        driver.putPermanentOnBattlefield(me, "Test Artifact Leave Watcher")
+        val corpse = driver.putCardInGraveyard(me, "Centaur Courser")
+        val life = driver.getLifeTotal(me)
+
+        driver.raise(me, corpse)
+
+        driver.getLifeTotal(me) shouldBe life
+    }
+
+    test("a granted-artifact creature card put into your graveyard fires a put-into-graveyard artifact watcher") {
+        val driver = newDriver()
+        val me = driver.player1
+        driver.putPermanentOnBattlefield(me, "Test Biotransference")
+        driver.putPermanentOnBattlefield(me, "Test Artifact Arrival Watcher")
+        val courser = driver.putPermanentOnBattlefield(me, "Centaur Courser")
+        val life = driver.getLifeTotal(me)
+
+        val bolt = driver.putCardInHand(me, "Lightning Bolt")
+        driver.giveMana(me, Color.RED, 1)
+        driver.castSpell(me, bolt, listOf(courser)).error shouldBe null
+        driver.bothPass()
+        driver.bothPass()
+
+        driver.getLifeTotal(me) shouldBe life + 1
+    }
+})
