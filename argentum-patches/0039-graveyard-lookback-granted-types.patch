+        if (granted.isEmpty() && !had) return this
+        return updateEntity(entityId) { c ->
+            if (granted.isEmpty()) c.without<com.wingedsheep.engine.state.components.identity.GraveyardLookBackTypesComponent>()
+            else c.with(com.wingedsheep.engine.state.components.identity.GraveyardLookBackTypesComponent(granted))
+        }
     }
 
