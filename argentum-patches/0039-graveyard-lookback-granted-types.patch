+/**
+ * The card types a cross-zone grant gave this card while it was in a graveyard, frozen as it left
+ * (CR 603.10a look-back for "whenever one or more artifact cards leave your graveyard" —
+ * Imotekh the Stormlord with Biotransference). Stamped by `GameState.removeFromZone` on every
+ * graveyard departure that has such types (and cleared on one that has none); read only by the
+ * leave-graveyard batch trigger detector. Card type names as in [CardType.name].
+ */
+@Serializable
+data class GraveyardLookBackTypesComponent(val cardTypes: Set<String>) : Component
diff --git a/rules-engine/src/test/kotlin/com/wingedsheep/engine/mechanics/layers/GraveyardLookBackCardTypeTest.kt b/rules-engine/src/test/kotlin/com/wingedsheep/engine/mechanics/layers/GraveyardLookBackCardTypeTest.kt
