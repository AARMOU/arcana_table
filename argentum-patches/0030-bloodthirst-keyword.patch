+    /**
+     * The +1/+1 counters the entering permanent's bloodthirst abilities put on it — the sum of every
+     * instance's N, or zero when no opponent of [controllerId] was dealt damage this turn.
+     *
+     * Read off the entrant's projected keywords as it would exist on the battlefield (CR 614.12), so a grant from a
+     * permanent already there counts and a "loses all abilities" effect that applies to it removes
+     * both kinds:
+     * - **printed** `Bloodthirst N` is gated on the projected bare `BLOODTHIRST` keyword, N read from
+     *   the printed definition (needs [cardRegistry]; without one only granted instances count);
+     * - **granted** `BLOODTHIRST_<n>` keywords count once per grant instance.
+     */
+    fun bloodthirstCount(
+        state: GameState,
+        entityId: EntityId,
+        controllerId: EntityId,
+        cardRegistry: CardRegistry?,
+        predicateEvaluator: PredicateEvaluator,
+        replacementSourceState: GameState? = null
+    ): Int {
+        // The spell-resolution path applies entry replacements before the permanent is put into the
+        // battlefield zone; project it there so grants and ability-loss effects that would apply to it
+        // once it's on the battlefield are seen.
+        val onBattlefield = if (entityId in state.getBattlefield()) state
+            else state.addToZone(ZoneKey(controllerId, Zone.BATTLEFIELD), entityId)
+        val projected = prospectiveEntryView(onBattlefield, entityId, replacementSourceState).projectedState
+        val keywords = projected.getKeywords(entityId)
+        if (keywords.isEmpty()) return 0
+        val printed = if (Keyword.BLOODTHIRST.name in keywords) {
+            val defId = state.getEntity(entityId)?.get<CardComponent>()?.cardDefinitionId
+            defId?.let { cardRegistry?.getCard(it) }?.let(Bloodthirst::printedCounts).orEmpty().sum()
+        } else 0
+        val granted = keywords.sumOf { keyword ->
+            val n = Bloodthirst.grantedN(keyword) ?: return@sumOf 0
+            n * projected.grantedKeywordInstances(entityId, keyword)
+        }
+        val total = printed + granted
+        if (total <= 0) return 0
+        val context = EffectContext(sourceId = entityId, controllerId = controllerId)
+        return if (predicateEvaluator.conditions.evaluate(state, Bloodthirst.condition, context)) total else 0
+    }
