+package com.wingedsheep.engine.scenarios
+
+import com.wingedsheep.engine.state.components.battlefield.CountersComponent
+import com.wingedsheep.engine.support.GameTestDriver
+import com.wingedsheep.engine.support.TestCards
+import com.wingedsheep.sdk.core.Color
+import com.wingedsheep.sdk.core.CounterType
+import com.wingedsheep.sdk.core.Keyword
+import com.wingedsheep.sdk.core.Step
+import com.wingedsheep.sdk.dsl.card
+import com.wingedsheep.sdk.model.Deck
+import com.wingedsheep.sdk.model.EntityId
+import com.wingedsheep.sdk.scripting.GameObjectFilter
+import com.wingedsheep.sdk.scripting.GrantKeyword
+import com.wingedsheep.sdk.scripting.KeywordAbility
+import com.wingedsheep.sdk.scripting.LoseAllAbilities
+import com.wingedsheep.sdk.scripting.filters.unified.GroupFilter
+import com.wingedsheep.sdk.scripting.predicates.CardPredicate
+import io.kotest.assertions.withClue
+import io.kotest.core.spec.style.FunSpec
+import io.kotest.matchers.shouldBe
+
+/**
+ * Bloodthirst N — "if an opponent was dealt damage this turn, this permanent enters with N +1/+1
+ * counters on it" — printed (`KeywordAbility.bloodthirst(n)`) and granted
+ * (`GrantKeyword(KeywordAbility.grantedBloodthirst(n), …)`), applied at the entry seam from the
+ * entrant's projected keywords.
+ */
+class BloodthirstKeywordTest : FunSpec({
+
+    val printed = card("Test Bloodthirsty Brute") {
+        manaCost = "{1}{R}"
+        typeLine = "Creature — Ogre"
+        oracleText = "Bloodthirst 2"
+        power = 2
+        toughness = 2
+        keywordAbility(KeywordAbility.bloodthirst(2))
+    }
+    val granter = card("Test Thirst Totem") {
+        manaCost = "{3}"
+        typeLine = "Artifact Creature — Eldrazi"
+        oracleText = "Each other colorless creature you control has bloodthirst 2."
+        power = 0
+        toughness = 1
+        staticAbility {
+            ability = GrantKeyword(
+                KeywordAbility.grantedBloodthirst(2),
+                GroupFilter(
+                    GameObjectFilter.Creature.withCardPredicate(CardPredicate.IsColorless).youControl(),
+                    excludeSelf = true,
+                ),
+            )
+        }
+    }
+    val colorless = card("Test Colorless Walker") {
+        manaCost = "{2}"
+        typeLine = "Artifact Creature — Construct"
+        oracleText = ""
+        power = 1
+        toughness = 1
+    }
+    val colorlessThirsty = card("Test Colorless Brute") {
+        manaCost = "{2}"
+        typeLine = "Artifact Creature — Construct"
+        oracleText = "Bloodthirst 1"
+        power = 1
+        toughness = 1
+        keywordAbility(KeywordAbility.bloodthirst(1))
+    }
+    val humility = card("Test Ability Drain") {
+        manaCost = "{2}{W}{W}"
+        typeLine = "Enchantment"
+        oracleText = "All creatures lose all abilities."
+        staticAbility { ability = LoseAllAbilities(GroupFilter(GameObjectFilter.Creature)) }
+    }
+
+    fun newDriver(): Pair<GameTestDriver, EntityId> {
+        val driver = GameTestDriver()
+        driver.registerCards(TestCards.all + listOf(printed, granter, colorless, colorlessThirsty, humility))
+        driver.initMirrorMatch(deck = Deck.of("Mountain" to 40), skipMulligans = true, startingPlayer = 0)
+        val me = driver.activePlayer!!
+        driver.passPriorityUntil(Step.PRECOMBAT_MAIN)
+        return driver to me
+    }
+
+    fun GameTestDriver.settle() {
+        repeat(20) { if (state.stack.isEmpty()) return; bothPass() }
+    }
+
+    fun GameTestDriver.bolt(caster: EntityId, target: EntityId) {
+        giveMana(caster, Color.RED)
+        castSpell(caster, putCardInHand(caster, "Lightning Bolt"), listOf(target)).error shouldBe null
+        settle()
+    }
+
+    fun GameTestDriver.cast(caster: EntityId, name: String): EntityId {
+        giveMana(caster, Color.RED)
+        giveColorlessMana(caster, 2)
+        val id = putCardInHand(caster, name)
+        castSpell(caster, id).error shouldBe null
+        settle()
+        (id in state.getBattlefield()) shouldBe true
+        return id
+    }
+
+    fun GameTestDriver.plusCounters(id: EntityId): Int =
+        state.getEntity(id)?.get<CountersComponent>()?.getCount(CounterType.PLUS_ONE_PLUS_ONE) ?: 0
+
+    test("printed bloodthirst: counters on entry once an opponent was dealt damage") {
+        val (d, me) = newDriver()
+        d.bolt(me, d.getOpponent(me))
+        val brute = d.cast(me, "Test Bloodthirsty Brute")
+        d.plusCounters(brute) shouldBe 2
+        d.state.projectedState.hasKeyword(brute, Keyword.BLOODTHIRST) shouldBe true
+    }
+
+    test("printed bloodthirst: nothing without opponent damage, and damage to yourself doesn't count") {
+        val (d, me) = newDriver()
+        d.plusCounters(d.cast(me, "Test Bloodthirsty Brute")) shouldBe 0
+        d.bolt(me, me)
+        d.plusCounters(d.cast(me, "Test Bloodthirsty Brute")) shouldBe 0
+    }
+
+    test("granted bloodthirst: the entering creature has it as a keyword and gets the counters") {
+        val (d, me) = newDriver()
+        d.putPermanentOnBattlefield(me, "Test Thirst Totem")
+        d.bolt(me, d.getOpponent(me))
+        val walker = d.cast(me, "Test Colorless Walker")
+        d.plusCounters(walker) shouldBe 2
+        d.state.projectedState.hasKeyword(walker, KeywordAbility.grantedBloodthirst(2)) shouldBe true
+    }
+
+    test("granted bloodthirst: only matching creatures, and not without opponent damage") {
+        val (d, me) = newDriver()
+        d.putPermanentOnBattlefield(me, "Test Thirst Totem")
+        withClue("no damage yet") { d.plusCounters(d.cast(me, "Test Colorless Walker")) shouldBe 0 }
+        d.bolt(me, d.getOpponent(me))
+        withClue("a red creature gets only its printed 2, no grant") { d.plusCounters(d.cast(me, "Test Bloodthirsty Brute")) shouldBe 2 }
+    }
+
+    test("instances stack: two grants plus a printed bloodthirst") {
+        val (d, me) = newDriver()
+        d.putPermanentOnBattlefield(me, "Test Thirst Totem")
+        d.putPermanentOnBattlefield(me, "Test Thirst Totem")
+        d.bolt(me, d.getOpponent(me))
+        val walker = d.cast(me, "Test Colorless Walker")
+        d.plusCounters(walker) shouldBe 4
+        d.state.projectedState.grantedKeywordInstances(walker, KeywordAbility.grantedBloodthirst(2)) shouldBe 2
+        withClue("printed 1 + granted 2 + 2") { d.plusCounters(d.cast(me, "Test Colorless Brute")) shouldBe 5 }
+    }
+
+    test("losing all abilities removes printed and granted bloodthirst") {
+        // The granter is a creature too, so "all creatures lose all abilities" strips the grant at
+        // its source (as with Twins of Discord) and the entrant's printed bloodthirst alike.
+        val (d, me) = newDriver()
+        d.giveColorlessMana(me, 3)
+        d.castSpell(me, d.putCardInHand(me, "Test Thirst Totem")).error shouldBe null
+        d.settle()
+        d.giveMana(me, Color.WHITE, 2)
+        d.giveColorlessMana(me, 2)
+        d.castSpell(me, d.putCardInHand(me, "Test Ability Drain")).error shouldBe null
+        d.settle()
+        d.bolt(me, d.getOpponent(me))
+        val brute = d.cast(me, "Test Colorless Brute")
+        val keywords = d.state.projectedState.getKeywords(brute)
