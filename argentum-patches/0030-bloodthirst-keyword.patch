+package com.wingedsheep.sdk.scripting
+
+import com.wingedsheep.sdk.core.Keyword
+import com.wingedsheep.sdk.model.CardDefinition
+import com.wingedsheep.sdk.scripting.conditions.Compare
+import com.wingedsheep.sdk.scripting.conditions.ComparisonOperator
+import com.wingedsheep.sdk.scripting.conditions.Condition
+import com.wingedsheep.sdk.scripting.references.Player
+import com.wingedsheep.sdk.scripting.values.DynamicAmount
+import com.wingedsheep.sdk.scripting.values.TurnTracker
+
+/**
+ * Bloodthirst N as pure data — the replacement effect every bloodthirst permanent has and none of
+ * them prints as a separate line. Twins of Discord's reminder text for a granted "bloodthirst 2":
+ *
+ * > "If an opponent was dealt damage this turn, that creature enters with two additional +1/+1
+ * > counters on it."
+ *
+ * A replacement effect on the permanent's own entry (CR 614.1c): no trigger, no stack, the counters
+ * are on it as it enters and counter-placement replacements apply to them.
+ *
+ * **Printed and granted bloodthirst derive separately**, the [Renown] shape:
+ *  - **Printed** — `keywordAbility(KeywordAbility.bloodthirst(n))`. The engine gates it on the
+ *    entering permanent's *projected* bare `BLOODTHIRST` keyword, so a permanent that would enter
+ *    having lost all abilities has no bloodthirst, and reads N from the printed
+ *    [KeywordAbility.Numeric] ([printedCounts]).
+ *  - **Granted** — `GrantKeyword(KeywordAbility.grantedBloodthirst(n), filter)` ("Each other
+ *    colorless creature you control has bloodthirst 2", Twins of Discord) floats the projected
+ *    keyword `BLOODTHIRST_<n>` ([grantedKeyword]). Projection never sums bloodthirst grants: each
+ *    grant is its own instance and identical ones are tallied, so two "has bloodthirst 2" grants
+ *    show as two instances and add 2 + 2 counters.
+ *
+ * Whether the permanent has bloodthirst is read from its projected characteristics as it would
+ * exist on the battlefield (CR 614.12), so a grant from a permanent already there applies, and a
+ * later-timestamped "loses all abilities" effect that covers it removes printed and granted
+ * instances alike (layer 6). "An opponent" is relative to the entering permanent's controller.
+ */
+object Bloodthirst {
+
+    /** The projected keyword prefix a granted bloodthirst floats under; see [grantedKeyword]. */
+    private val GRANTED_PREFIX = "${Keyword.BLOODTHIRST.name}_"
+
+    /**
+     * The projected keyword string a *granted* "bloodthirst [n]" floats — `BLOODTHIRST_<n>`. Cards
+     * spell it [KeywordAbility.grantedBloodthirst].
+     */
+    fun grantedKeyword(n: Int): String = "$GRANTED_PREFIX$n"
+
+    /** The N of a projected granted-bloodthirst keyword string, or null when [keyword] isn't one. */
+    fun grantedN(keyword: String): Int? =
+        if (keyword.startsWith(GRANTED_PREFIX)) keyword.substring(GRANTED_PREFIX.length).toIntOrNull()?.takeIf { it > 0 }
+        else null
+
+    /** The Ns of a card's printed `Bloodthirst N` abilities, one per instance. */
+    fun printedCounts(cardDef: CardDefinition): List<Int> =
+        cardDef.keywordAbilities
+            .filterIsInstance<KeywordAbility.Numeric>()
+            .filter { it.keyword == Keyword.BLOODTHIRST }
+            .map { it.n }
+
+    /**
+     * "If an opponent was dealt damage this turn" — evaluated with the entering permanent's
+     * controller as "you". Damage only: life loss that isn't damage doesn't count.
+     */
+    val condition: Condition = Compare(
+        DynamicAmount.TurnTracking(Player.EachOpponent, TurnTracker.DAMAGE_RECEIVED),
+        ComparisonOperator.GTE,
+        DynamicAmount.Fixed(1),
+    )
+}
