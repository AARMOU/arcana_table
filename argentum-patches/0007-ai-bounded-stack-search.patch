diff --git a/ai/src/main/kotlin/com/wingedsheep/ai/engine/RetargetingCandidateFilter.kt b/ai/src/main/kotlin/com/wingedsheep/ai/engine/RetargetingCandidateFilter.kt
new file mode 100644
index 0000000..582d3b1
--- /dev/null
+++ b/ai/src/main/kotlin/com/wingedsheep/ai/engine/RetargetingCandidateFilter.kt
@@ -0,0 +1,28 @@
+package com.wingedsheep.ai.engine
+
+import com.wingedsheep.engine.core.ActivateAbility
+import com.wingedsheep.engine.legalactions.LegalAction
+import com.wingedsheep.engine.registry.CardRegistry
+import com.wingedsheep.engine.state.GameState
+import com.wingedsheep.engine.state.components.identity.CardComponent
+import com.wingedsheep.engine.state.components.stack.TargetsComponent
+import com.wingedsheep.sdk.scripting.effects.ChangeTargetEffect
+
+/** AI search pruning only. A targetless stack object is still a legal redirect-ability target. */
+object RetargetingCandidateFilter {
+    fun hasPotentialEffect(state: GameState, offer: LegalAction, registry: CardRegistry): Boolean {
+        val activation = offer.action as? ActivateAbility ?: return true
+        val card = state.getEntity(activation.sourceId)?.get<CardComponent>() ?: return true
+        val effect = registry.getCard(card.cardDefinitionId)?.script?.activatedAbilities
+            ?.find { it.id == activation.abilityId }?.effect ?: return true
+        // Composite effects and unreadable/granted abilities may have another payoff. Keep them.
+        if (effect !is ChangeTargetEffect || !offer.requiresTargets ||
+            (offer.targetRequirements?.size ?: 1) > 1) return true
+        val candidates = offer.validTargets ?: return true
+        return candidates.any { id ->
+            // Unknown objects are conservatively retained, rather than silently vetoed.
+            val entity = state.getEntity(id) ?: return@any true
+            !entity.get<TargetsComponent>()?.targets.isNullOrEmpty()
+        }
+    }
+}
