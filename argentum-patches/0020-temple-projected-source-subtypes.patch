From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: arcana-weekly-bot
 <41898282+github-actions[bot]@users.noreply.github.com>
Date: Sat, 1 Jan 2000 00:00:00 +0000
Subject: [PATCH] arcana: 0020-temple-projected-source-subtypes

---
 .../mechanics/mana/AbilityPaymentContextBuilder.kt |  6 ++++++
 .../wingedsheep/engine/mechanics/mana/ManaPool.kt  | 14 +++++++++++---
 2 files changed, 17 insertions(+), 3 deletions(-)

diff --git a/rules-engine/src/main/kotlin/com/wingedsheep/engine/mechanics/mana/AbilityPaymentContextBuilder.kt b/rules-engine/src/main/kotlin/com/wingedsheep/engine/mechanics/mana/AbilityPaymentContextBuilder.kt
index befb346ca1..28aaf5e308 100644
--- a/rules-engine/src/main/kotlin/com/wingedsheep/engine/mechanics/mana/AbilityPaymentContextBuilder.kt
+++ b/rules-engine/src/main/kotlin/com/wingedsheep/engine/mechanics/mana/AbilityPaymentContextBuilder.kt
@@ -51,6 +51,12 @@ internal fun buildAbilityPaymentContext(
         },
         isAbilitySourceOnBattlefield = sourceId in projected.getBaseState().getBattlefield(),
         subtypes = subtypes,
+        // Battlefield subtype-changing effects are authoritative for "abilities of [subtype]" (layer 4).
+        abilitySourceSubtypes = if (sourceId in projected.getBaseState().getBattlefield()) {
+            projected.getSubtypes(sourceId)
+        } else {
+            null
+        },
         isEquipAbilityActivation = ability?.isEquipAbility == true,
         isClassLevelUpActivation = ability?.effect is com.wingedsheep.sdk.scripting.effects.LevelUpClassEffect,
         hasXInCost = ability?.cost?.extractManaCost()?.hasX == true,
diff --git a/rules-engine/src/main/kotlin/com/wingedsheep/engine/mechanics/mana/ManaPool.kt b/rules-engine/src/main/kotlin/com/wingedsheep/engine/mechanics/mana/ManaPool.kt
index a672dd909d..bd802fb49e 100644
--- a/rules-engine/src/main/kotlin/com/wingedsheep/engine/mechanics/mana/ManaPool.kt
+++ b/rules-engine/src/main/kotlin/com/wingedsheep/engine/mechanics/mana/ManaPool.kt
@@ -155,6 +155,13 @@ data class SpellPaymentContext(
      * [ManaPool.payPartialExactly].
      */
     val spendAsAnyColor: ManaSpentAsAnyColor? = null,
+    /**
+     * Current subtypes of a battlefield ability source, from the layer projection only (null off the
+     * battlefield or for spells). [subtypes] unions printed and projected values for restrictions that
+     * must still see printed types; "abilities of colorless Eldrazi" asks what the permanent IS now, so a
+     * former Eldrazi that became only a Frog no longer qualifies (CR 613: characteristics after layer 4).
+     */
+    val abilitySourceSubtypes: Set<String>? = null,
 ) {
     init {
         require(!isEquipAbilityActivation || isAbilityActivation) {
@@ -234,9 +241,10 @@ fun ManaRestriction.isSatisfiedBy(context: SpellPaymentContext): Boolean = when
     is ManaRestriction.ColoredSpellsOnly ->
         context.isSpellCast && (context.colorCount ?: 0) >= 1 && !(withoutXInCost && context.hasXInCost)
     is ManaRestriction.ColorlessSubtypeSpellsOrAbilitiesOnly ->
-        context.subtypes.any { it.equals(subtype, ignoreCase = true) } &&
-            ((context.isSpellCast && context.isColorless) ||
-                (context.isAbilityActivation && context.isAbilitySourceColorless))
+        (context.isSpellCast && context.isColorless &&
+            context.subtypes.any { it.equals(subtype, ignoreCase = true) }) ||
+            (context.isAbilityActivation && context.isAbilitySourceColorless &&
+                (context.abilitySourceSubtypes ?: context.subtypes).any { it.equals(subtype, ignoreCase = true) })
     is ManaRestriction.DevoidSpellsOnly -> context.isSpellCast && context.isDevoid
     is ManaRestriction.SpellsWithExactColorCount -> context.isSpellCast && context.colorCount == count
     is ManaRestriction.CostsContainingXOnly -> (context.isSpellCast || context.isAbilityActivation) && context.hasXInCost
