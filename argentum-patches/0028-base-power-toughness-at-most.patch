diff --git a/rules-engine/src/test/kotlin/com/wingedsheep/engine/scenarios/BasePowerOrToughnessAtMostTest.kt b/rules-engine/src/test/kotlin/com/wingedsheep/engine/scenarios/BasePowerOrToughnessAtMostTest.kt
new file mode 100644
index 00000000..10283a36
--- /dev/null
+++ b/rules-engine/src/test/kotlin/com/wingedsheep/engine/scenarios/BasePowerOrToughnessAtMostTest.kt
@@ -0,0 +1,141 @@
+package com.wingedsheep.engine.scenarios
+
+import com.wingedsheep.engine.core.SelectCardsDecision
+import com.wingedsheep.engine.state.components.battlefield.CountersComponent
+import com.wingedsheep.engine.support.ScenarioTestBase
+import com.wingedsheep.sdk.core.CounterType
+import com.wingedsheep.sdk.core.Phase
+import com.wingedsheep.sdk.core.Step
+import com.wingedsheep.sdk.dsl.Effects
+import com.wingedsheep.sdk.dsl.card
+import com.wingedsheep.sdk.model.EntityId
+import com.wingedsheep.sdk.scripting.Duration
+import com.wingedsheep.sdk.scripting.GameObjectFilter
+import com.wingedsheep.sdk.scripting.filters.unified.TargetFilter
+import io.kotest.assertions.withClue
+import io.kotest.matchers.collections.shouldContainExactlyInAnyOrder
+import io.kotest.matchers.shouldBe
+
+/**
+ * `CardPredicate.BasePowerAtMost` / `BaseToughnessAtMost` and their `Or`,
+ * `.basePowerOrToughnessAtMost(n)`: "creatures each with base power or toughness 1 or less"
+ * (Angelic Aberration). Either half qualifies (base 0/2, 1/3, 3/1); base values ignore counters
+ * and pumps, but a set-base-P/T effect changes them. The equality filter `.basePowerOrToughness(1)`
+ * keeps its meaning (base 0/2 is not "base power or toughness 1").
+ */
+class BasePowerOrToughnessAtMostTest : ScenarioTestBase() {
+
+    private val zeroTwo = card("AtMost Zero Two") {
+        manaCost = "{1}"; typeLine = "Creature — Test"; power = 0; toughness = 2
+    }
+    private val oneThree = card("AtMost One Three") {
+        manaCost = "{1}"; typeLine = "Creature — Test"; power = 1; toughness = 3
+    }
+    private val threeOne = card("AtMost Three One") {
+        manaCost = "{1}"; typeLine = "Creature — Test"; power = 3; toughness = 1
+    }
+    private val threeThree = card("AtMost Three Three") {
+        manaCost = "{1}"; typeLine = "Creature — Test"; power = 3; toughness = 3
+    }
+    private val culler = card("AtMost Culler") {
+        manaCost = "{0}"
+        typeLine = "Sorcery"
+        oracleText = "Sacrifice any number of creatures each with base power or toughness 1 or less."
+        spell { effect = Effects.SacrificeAnyNumber(GameObjectFilter.Creature.basePowerOrToughnessAtMost(1)) }
+    }
+    private val equalityCuller = card("Equality Culler") {
+        manaCost = "{0}"
+        typeLine = "Sorcery"
+        oracleText = "Sacrifice any number of creatures each with base power or toughness 1."
+        spell { effect = Effects.SacrificeAnyNumber(GameObjectFilter.Creature.basePowerOrToughness(1)) }
+    }
+    private val powerOnlyCuller = card("Power AtMost Culler") {
+        manaCost = "{0}"
+        typeLine = "Sorcery"
+        oracleText = "Sacrifice any number of creatures each with base power 1 or less."
+        spell { effect = Effects.SacrificeAnyNumber(GameObjectFilter.Creature.basePowerAtMost(1)) }
+    }
+    private val setOneOne = card("AtMost Base 1/1") {
+        manaCost = "{0}"
+        typeLine = "Instant"
+        oracleText = "Target creature has base power and toughness 1/1 until end of turn."
+        spell {
+            val creature = target(TargetFilter.Creature)
+            effect = Effects.SetBasePowerAndToughness(1, 1, creature, Duration.EndOfTurn)
+        }
+    }
+
+    init {
+        cardRegistry.register(listOf(zeroTwo, oneThree, threeOne, threeThree, culler, equalityCuller, powerOnlyCuller, setOneOne))
+
+        fun board(spell: String) = scenario()
+            .withPlayers("P1", "P2")
+            .withCardInHand(1, spell)
+            .withCardInHand(1, "AtMost Base 1/1")
+            .withCardOnBattlefield(1, "AtMost Zero Two")
+            .withCardOnBattlefield(1, "AtMost One Three")
+            .withCardOnBattlefield(1, "AtMost Three One")
+            .withCardOnBattlefield(1, "AtMost Three Three")
+            .withCardOnBattlefield(1, "Grizzly Bears")
+            .withCardOnBattlefield(2, "AtMost Zero Two")
+            .withActivePlayer(1)
+            .inPhase(Phase.PRECOMBAT_MAIN, Step.PRECOMBAT_MAIN)
+            .build()
+
+        fun TestGame.mine(name: String): EntityId =
+            findPermanents(name).single { state.getEntity(it)?.get<com.wingedsheep.engine.state.components.identity.ControllerComponent>()?.playerId == player1Id }
+
+        fun TestGame.castAndGetOptions(spell: String): List<EntityId> {
+            withClue("cast $spell") { castSpell(1, spell).error shouldBe null }
+            resolveStack()
+            val decision = getPendingDecision() as SelectCardsDecision
+            decision.minSelections shouldBe 0
+            return decision.options
+        }
+
+        test("either base stat at most 1 qualifies; base 2/2 and 3/3 don't; only your own creatures") {
+            val game = board("AtMost Culler")
+            val options = game.castAndGetOptions("AtMost Culler")
+            options shouldContainExactlyInAnyOrder listOf(
+                game.mine("AtMost Zero Two"), game.mine("AtMost One Three"), game.mine("AtMost Three One"),
+            )
+            game.selectCards(listOf(game.mine("AtMost Zero Two"), game.mine("AtMost Three One"))).error shouldBe null
+            game.isInGraveyard(1, "AtMost Zero Two") shouldBe true
+            game.isInGraveyard(1, "AtMost Three One") shouldBe true
+            withClue("unchosen eligible creature stays") { game.findPermanents("AtMost One Three").size shouldBe 1 }
+        }
+
+        test("counters raise current P/T but not base P/T; a -1/-1 counter doesn't lower base") {
+            val game = board("AtMost Culler")
+            val zero = game.mine("AtMost Zero Two")
+            val bears = game.mine("Grizzly Bears")
+            game.state = game.state
+                .updateEntity(zero) { it.with(CountersComponent(mapOf(CounterType.PLUS_ONE_PLUS_ONE to 3))) }
+                .updateEntity(bears) { it.with(CountersComponent(mapOf(CounterType.MINUS_ONE_MINUS_ONE to 1))) }
+            val options = game.castAndGetOptions("AtMost Culler")
+            withClue("a 3/5 with base 0/2 still qualifies") { (zero in options) shouldBe true }
+            withClue("a 1/1 Grizzly Bears (base 2/2) does not") { (bears in options) shouldBe false }
+        }
+
+        test("a set-base-P/T effect makes a 3/3 qualify") {
+            val game = board("AtMost Culler")
+            val big = game.mine("AtMost Three Three")
+            game.castSpell(1, "AtMost Base 1/1", big).error shouldBe null
+            game.resolveStack()
+            val options = game.castAndGetOptions("AtMost Culler")
+            (big in options) shouldBe true
+        }
+
+        test("basePowerAtMost alone reads only power") {
+            val game = board("Power AtMost Culler")
+            val options = game.castAndGetOptions("Power AtMost Culler")
+            options shouldContainExactlyInAnyOrder listOf(game.mine("AtMost Zero Two"), game.mine("AtMost One Three"))
+        }
+
+        test("the equality filter basePowerOrToughness(1) is unchanged: base 0/2 is excluded") {
+            val game = board("Equality Culler")
+            val options = game.castAndGetOptions("Equality Culler")
+            options shouldContainExactlyInAnyOrder listOf(game.mine("AtMost One Three"), game.mine("AtMost Three One"))
+        }
+    }
+}
