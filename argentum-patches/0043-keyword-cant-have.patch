diff --git a/mtg-sdk/src/main/kotlin/com/wingedsheep/sdk/scripting/effects/KeywordAndAbilityEffects.kt b/mtg-sdk/src/main/kotlin/com/wingedsheep/sdk/scripting/effects/KeywordAndAbilityEffects.kt
