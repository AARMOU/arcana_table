+++ b/mtg-sdk/src/main/kotlin/com/wingedsheep/sdk/scripting/effects/KeywordAndAbilityEffects.kt
@@ -76,13 +76,21 @@ data class GrantKeywordEffect(
 data class RemoveKeywordEffect(
     val keyword: String,
     val target: EffectTarget,
-    val duration: Duration = Duration.EndOfTurn
+    val duration: Duration = Duration.EndOfTurn,
+    /**
+     * "… loses [keyword] and can't have [keyword]" (Arcane Lighthouse). For the duration the
+     * permanent can't have the keyword at all: grants with a later timestamp — resolved effects
+     * and static abilities alike — don't give it back (rulings 2014-11-07). The default `false`
+     * is the plain timestamp-ordered loss, which a later grant overrides (CR 613.7).
+     */
+    val cantHave: Boolean = false,
 ) : Effect {
     constructor(keyword: Keyword, target: EffectTarget, duration: Duration = Duration.EndOfTurn) :
         this(keyword.name, target, duration)
 
     override val description: String = buildString {
         append(com.wingedsheep.sdk.scripting.util.describeKeywordLoss(target.description, keyword))
+        if (cantHave) append(" and can't have ${keyword.lowercase().replace('_', ' ')}")
         if (duration.description.isNotEmpty()) append(" ${duration.description}")
     }
 }
