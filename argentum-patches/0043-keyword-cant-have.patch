+++ b/rules-engine/src/main/kotlin/com/wingedsheep/engine/mechanics/layers/StateProjector.kt
@@ -418,6 +418,15 @@ class StateProjector {
             }
         }
 
+        // "Can't have" (Arcane Lighthouse): a keyword a can't-have effect forbids stays off whatever
+        // granted it in Layer 6 and whenever — a later-timestamped grant, a static ability or a
+        // keyword counter (rulings 2014-11-07).
+        for (values in projectedValues.values) {
+            if (values.cantHaveKeywords.isEmpty()) continue
+            values.keywords.removeAll(values.cantHaveKeywords)
+            values.cantHaveKeywords.forEach { values.grantedKeywordInstances.remove(it) }
+        }
+
         // CR 702.147a: Decayed's "can't block" half, realized off the final keyword set — so a
         // printed Decayed, a token created "with decayed", a decayed counter and a granted Decayed
         // all behave alike, and a creature that lost all abilities in Layer 6 can block again.
