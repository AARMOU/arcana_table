+package com.wingedsheep.engine.scenarios
+
+import com.wingedsheep.engine.core.ActivateAbility
+import com.wingedsheep.engine.support.GameTestDriver
+import com.wingedsheep.engine.support.TestCards
+import com.wingedsheep.sdk.core.Keyword
+import com.wingedsheep.sdk.core.ManaCost
+import com.wingedsheep.sdk.core.Step
+import com.wingedsheep.sdk.core.Zone
+import com.wingedsheep.sdk.dsl.Effects
+import com.wingedsheep.sdk.dsl.card
+import com.wingedsheep.sdk.dsl.unearthAbility
+import com.wingedsheep.sdk.model.Deck
+import com.wingedsheep.sdk.model.EntityId
+import com.wingedsheep.sdk.scripting.ActivatedAbility
+import com.wingedsheep.sdk.scripting.AbilityCost
+import com.wingedsheep.sdk.scripting.AbilityId
+import com.wingedsheep.sdk.scripting.GameObjectFilter
+import com.wingedsheep.sdk.scripting.effects.CardSource
+import com.wingedsheep.sdk.scripting.references.Player
+import com.wingedsheep.sdk.scripting.targets.EffectTarget
+import io.kotest.assertions.withClue
+import io.kotest.core.spec.style.FunSpec
+import io.kotest.matchers.shouldBe
+
+/**
+ * `GrantActivatedAbility` onto **cards in a graveyard**: an ability whose `activateFromZone` is the
+ * zone the card is in may be granted to it. Composed with a resolution-time gather and
+ * `ForEachInCollection` this is "each artifact creature card in your graveyard gains unearth {3}
+ * until end of turn" (Ghost Ark): the set is fixed as the effect resolves (CR 611.2c), a card that
+ * leaves the graveyard is a new object without the ability (CR 400.7), and the grant ends at cleanup.
+ */
+class GrantActivatedAbilityToGraveyardCardsTest : FunSpec({
+
+    val unearth3 = unearthAbility(ManaCost.parse("{3}"))
+
+    val reassembly = card("Test Reassembly") {
+        manaCost = "{0}"
+        typeLine = "Sorcery"
+        oracleText = "Each artifact creature card in your graveyard gains unearth {3} until end of turn."
+        spell {
+            effect = Effects.Pipeline {
+                val cards = gather(CardSource.FromZone(Zone.GRAVEYARD, Player.You, GameObjectFilter.ArtifactCreature))
+                run(Effects.ForEachInCollection(cards, Effects.GrantActivatedAbility(unearth3, EffectTarget.IterationEntity)))
+            }
+        }
+    }
+
+    /** A battlefield ability granted to graveyard cards: still refused (nothing could activate it there). */
+    val battlefieldPing = ActivatedAbility(
+        id = AbilityId("test_battlefield_gain"),
+        cost = AbilityCost.Free,
+        effect = Effects.GainLife(1),
+    )
+    val wrongZoneGrant = card("Test Wrong Zone Grant") {
+        manaCost = "{0}"
+        typeLine = "Sorcery"
+        oracleText = "Each artifact creature card in your graveyard gains \"{0}: You gain 1 life.\" until end of turn."
+        spell {
+            effect = Effects.Pipeline {
+                val cards = gather(CardSource.FromZone(Zone.GRAVEYARD, Player.You, GameObjectFilter.ArtifactCreature))
+                run(Effects.ForEachInCollection(cards, Effects.GrantActivatedAbility(battlefieldPing, EffectTarget.IterationEntity)))
+            }
+        }
+    }
+
+    val recall = card("Test Construct Recall") {
+        manaCost = "{0}"
+        typeLine = "Sorcery"
+        oracleText = "Return each artifact creature card in your graveyard to your hand."
+        spell {
+            effect = Effects.Pipeline {
+                val cards = gather(CardSource.FromZone(Zone.GRAVEYARD, Player.You, GameObjectFilter.ArtifactCreature))
+                run(Effects.ForEachInCollection(cards, Effects.ReturnToHandFromGraveyard(EffectTarget.IterationEntity)))
+            }
+        }
+    }
+
+    val construct = card("Test Construct") {
+        manaCost = "{2}"
+        typeLine = "Artifact Creature — Construct"
+        power = 2
+        toughness = 2
+        oracleText = ""
+    }
+    val bear = card("Test Plain Bear") {
+        manaCost = "{1}{G}"
+        typeLine = "Creature — Bear"
+        power = 2
+        toughness = 2
+        oracleText = ""
+    }
+    val trinket = card("Test Trinket") {
+        manaCost = "{1}"
+        typeLine = "Artifact"
+        oracleText = ""
+    }
+
+    fun newDriver(): GameTestDriver {
+        val driver = GameTestDriver()
+        driver.registerCards(TestCards.all + listOf(reassembly, wrongZoneGrant, recall, construct, bear, trinket))
+        driver.initMirrorMatch(deck = Deck.of("Swamp" to 40), skipMulligans = true, startingPlayer = 0)
+        driver.passPriorityUntil(Step.PRECOMBAT_MAIN)
+        return driver
+    }
+
+    fun GameTestDriver.castAndResolve(name: String) {
+        val spell = putCardInHand(player1, name)
+        castSpell(player1, spell).error shouldBe null
+        bothPass()
+    }
+
+    fun GameTestDriver.hasUnearth(cardId: EntityId): Boolean =
+        state.grantedActivatedAbilities.any { it.entityId == cardId && it.ability.id == unearth3.id }
+
+    fun GameTestDriver.offersUnearth(cardId: EntityId): Boolean =
+        legalActions(player1).any {
+            val action = it.action
+            action is ActivateAbility && action.sourceId == cardId && action.abilityId == unearth3.id
+        }
+
+    test("each artifact creature card in your graveyard gains the ability, and only those") {
+        val driver = newDriver()
+        val c1 = driver.putCardInGraveyard(driver.player1, "Test Construct")
+        val c2 = driver.putCardInGraveyard(driver.player1, "Test Construct")
+        val creature = driver.putCardInGraveyard(driver.player1, "Test Plain Bear")
+        val artifact = driver.putCardInGraveyard(driver.player1, "Test Trinket")
+        val theirs = driver.putCardInGraveyard(driver.player2, "Test Construct")
+
+        driver.castAndResolve("Test Reassembly")
+
+        withClue("both artifact creature cards") { (driver.hasUnearth(c1) && driver.hasUnearth(c2)) shouldBe true }
+        withClue("not a non-artifact creature card") { driver.hasUnearth(creature) shouldBe false }
+        withClue("not a noncreature artifact card") { driver.hasUnearth(artifact) shouldBe false }
+        withClue("not a card in the opponent's graveyard") { driver.hasUnearth(theirs) shouldBe false }
+        driver.giveColorlessMana(driver.player1, 3)
+        withClue("the zone-ability enumerator offers it") { driver.offersUnearth(c1) shouldBe true }
+    }
+
+    test("the granted ability is the card's own: unearth returns it with haste") {
+        val driver = newDriver()
+        val c1 = driver.putCardInGraveyard(driver.player1, "Test Construct")
+        driver.castAndResolve("Test Reassembly")
+
+        driver.giveColorlessMana(driver.player1, 3)
+        driver.submit(ActivateAbility(playerId = driver.player1, sourceId = c1, abilityId = unearth3.id)).error shouldBe null
+        driver.bothPass()
+
+        withClue("on the battlefield") { (c1 in driver.state.getBattlefield()) shouldBe true }
+        driver.state.projectedState.hasKeyword(c1, Keyword.HASTE) shouldBe true
+    }
+
+    test("a card put into the graveyard after resolution does not gain it") {
+        val driver = newDriver()
+        driver.putCardInGraveyard(driver.player1, "Test Construct")
+        driver.castAndResolve("Test Reassembly")
+        val late = driver.putCardInGraveyard(driver.player1, "Test Construct")
+
+        driver.hasUnearth(late) shouldBe false
+        driver.giveColorlessMana(driver.player1, 3)
+        driver.offersUnearth(late) shouldBe false
+    }
+
+    test("a card that leaves the graveyard and comes back is a new object without it") {
+        val driver = newDriver()
+        val c1 = driver.putCardInGraveyard(driver.player1, "Test Construct")
+        driver.castAndResolve("Test Reassembly")
+        driver.hasUnearth(c1) shouldBe true
+
+        driver.castAndResolve("Test Construct Recall")
+        withClue("returned to hand") { (c1 in driver.state.getHand(driver.player1)) shouldBe true }
+        driver.hasUnearth(c1) shouldBe false
+
+        driver.moveToGraveyard(c1)
+        driver.giveColorlessMana(driver.player1, 3)
+        driver.offersUnearth(c1) shouldBe false
+    }
+
+    test("the grant ends at cleanup") {
+        val driver = newDriver()
+        val c1 = driver.putCardInGraveyard(driver.player1, "Test Construct")
+        driver.castAndResolve("Test Reassembly")
+        driver.hasUnearth(c1) shouldBe true
+
+        driver.passPriorityUntil(Step.UPKEEP, driver.player2)
+        driver.hasUnearth(c1) shouldBe false
+        driver.passPriorityUntil(Step.PRECOMBAT_MAIN, driver.player1)
+        driver.giveColorlessMana(driver.player1, 3)
+        driver.offersUnearth(c1) shouldBe false
+    }
+
+    test("an ability that does not activate from the graveyard is still refused there") {
+        val driver = newDriver()
+        val c1 = driver.putCardInGraveyard(driver.player1, "Test Construct")
+        driver.castAndResolve("Test Wrong Zone Grant")
+
+        driver.state.grantedActivatedAbilities.none { it.entityId == c1 } shouldBe true
+    }
+})
