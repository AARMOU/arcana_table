+    companion object {
+        private fun sun(name: String, anyAbility: Boolean) = card(name) {
+            typeLine = "Artifact"
+            staticAbility {
+                ability = AdditionalManaOnSourceTap(
+                    sourceFilter = GameObjectFilter.Land,
+                    color = null,
+                    whenProducing = TappedForManaType.CHOSEN_COLOR,
+                    anyManaAbility = anyAbility,
+                    onlyWhenYouAdd = true,
+                )
+            }
+        }
+        private val Sun = sun("Sun", anyAbility = true)
+        private val TapOnlySun = sun("Tap Only Sun", anyAbility = false)
+
+        private fun land(name: String, vararg colors: Color) = card(name) {
+            typeLine = "Land"
+            colors.forEach { c ->
+                activatedAbility {
+                    manaAbility = true
+                    cost = Costs.Tap
+                    effect = Effects.AddMana(c)
+                }
+            }
+        }
+        private val Grove = land("Grove", Color.GREEN)
+        private val Isle = land("Isle", Color.BLUE)
+        private val Dual = land("Dual", Color.GREEN, Color.BLUE)
+        private val GreenTwin = card("Green Twin") {
+            typeLine = "Land"
+            activatedAbility {
+                manaAbility = true
+                cost = Costs.Tap
+                effect = Effects.AddMana(Color.GREEN, 2)
+            }
+        }
+        private val Twinned = card("Twinned") {
+            typeLine = "Land"
+            activatedAbility {
+                manaAbility = true
+                cost = Costs.Tap
+                effect = Effects.AddMana(Color.GREEN).then(Effects.AddMana(Color.BLUE))
+            }
+        }
+        private val Pit = card("Pit") {
+            typeLine = "Land"
+            activatedAbility {
+                manaAbility = true
+                cost = Costs.SacrificeSelf
+                effect = Effects.AddMana(Color.GREEN)
+            }
+        }
+        private val Rock = card("Rock") {
+            typeLine = "Artifact"
+            activatedAbility {
+                manaAbility = true
+                cost = Costs.Tap
+                effect = Effects.AddMana(Color.GREEN)
+            }
+        }
+        private val GreenPair = card("Green Pair") {
+            manaCost = "{G}{G}"
+            typeLine = "Sorcery"
+            spell { effect = Effects.GainLife(1) }
+        }
+        private val BluePair = card("Blue Pair") {
+            manaCost = "{U}{U}"
+            typeLine = "Sorcery"
+            spell { effect = Effects.GainLife(1) }
+        }
+    }
