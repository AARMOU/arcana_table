+            withClue("tapped for {U}") { (game.pool().blue to game.pool().green) shouldBe (1 to 0) }
+            val other = board("Sun", "Dual")
+            other.choose("Sun", Color.GREEN)
+            other.mana(other.player1Id, "Dual", Dual, index = 0) // {T}: Add {G}
+            withClue("tapped for {G}") { (other.pool().green to other.pool().blue) shouldBe (2 to 0) }
+        }
