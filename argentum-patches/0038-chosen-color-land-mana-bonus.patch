+/**
+ * `AdditionalManaOnSourceTap(whenProducing = CHOSEN_COLOR, anyManaAbility = true, onlyWhenYouAdd = true)`:
+ * Caged Sun's "Whenever a land's ability causes you to add one or more mana of the chosen color, add
+ * an additional one mana of that color." A triggered mana ability (CR 605.1b) — fires on a land's mana
+ * ability with or without {T}, only when that ability added the static's chosen color, adds exactly one
+ * of it, and only when the mana went to the static's controller. Manual and auto-pay paths.
+ */
+class ChosenColorLandManaBonusTest : ScenarioTestBase() {
+
+    init {
+        cardRegistry.register(listOf(Sun, TapOnlySun, Grove, Isle, Dual, Pit, Rock, GreenTwin, Twinned, GreenPair, BluePair))
+
+        fun board(vararg mine: String, opp: List<String> = emptyList(), active: Int = 1, spell: String? = null) = scenario()
+            .withPlayers("Player", "Opponent")
+            .apply { mine.forEach { withCardOnBattlefield(1, it) } }
+            .apply { opp.forEach { withCardOnBattlefield(2, it) } }
+            .apply { if (spell != null) withCardInHand(1, spell) }
+            .withActivePlayer(active)
+            .inPhase(Phase.PRECOMBAT_MAIN, Step.PRECOMBAT_MAIN)
+            .build()
+
+        fun TestGame.nameOf(id: EntityId) = state.getEntity(id)?.get<CardComponent>()?.name
+
+        fun TestGame.choose(name: String, color: Color) {
+            state.getBattlefield().filter { nameOf(it) == name }.forEach { id ->
+                state = state.updateEntity(id) { c ->
+                    c.with(CastChoicesComponent(chosen = mapOf(ChoiceSlot.COLOR to ChoiceValue.ColorChoice(color))))
+                }
+            }
+        }
+
+        fun TestGame.idOf(player: EntityId, name: String): EntityId =
+            state.getBattlefield().first { nameOf(it) == name && state.projectedState.getController(it) == player }
+
+        fun TestGame.mana(player: EntityId, name: String, def: CardDefinition, index: Int = 0) {
+            val ability = def.activatedAbilities.filter { it.isManaAbility }[index]
+            execute(ActivateAbility(player, idOf(player, name), ability.id)).error shouldBe null
+        }
+
+        fun TestGame.pool(player: EntityId = player1Id) = state.getEntity(player)?.get<ManaPoolComponent>()!!
+
+        test("a land tapped for the chosen color adds one more of it") {
+            val game = board("Sun", "Grove")
+            game.choose("Sun", Color.GREEN)
+            game.mana(game.player1Id, "Grove", Grove)
+            game.pool().green shouldBe 2
+        }
+
+        test("a land tapped for another color gets nothing") {
+            val game = board("Sun", "Isle")
+            game.choose("Sun", Color.GREEN)
+            game.mana(game.player1Id, "Isle", Isle)
+            game.pool().blue shouldBe 1
+            game.pool().green shouldBe 0
+        }
+
+        test("a dual fires only when its ability added the chosen color") {
+            val game = board("Sun", "Dual")
+            game.choose("Sun", Color.GREEN)
