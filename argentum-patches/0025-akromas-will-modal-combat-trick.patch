+    /** A modal mode that grants temporary combat abilities to each member of a group. */
+    private fun hasExpiringGroupCombatGrant(effect: Effect): Boolean {
+        if (effect is ModalEffect && effect.modes.any { hasExpiringGroupCombatGrant(it.effect) }) return true
+        if (effect is CompositeEffect) return effect.effects.any(::hasExpiringGroupCombatGrant)
+        if (effect is ForEachEffect && effect.space is IterationSpace.Group) {
+            return EffectWalker.leaves(effect.body).any { leaf ->
+                (leaf as? GrantKeywordEffect)?.let {
+                    it.target == EffectTarget.IterationEntity &&
+                        it.duration == Duration.EndOfTurn &&
+                        (it.keyword in COMBAT_TRICK_KEYWORDS || it.keyword.startsWith("PROTECTION_FROM_"))
+                } == true
+            }
+        }
+        return false
+    }
+
+    private val COMBAT_TRICK_KEYWORDS = setOf(
+        Keyword.DEATHTOUCH.name, Keyword.DOUBLE_STRIKE.name, Keyword.FIRST_STRIKE.name,
+        Keyword.FLYING.name, Keyword.INDESTRUCTIBLE.name, Keyword.LIFELINK.name,
+        Keyword.MENACE.name, Keyword.REACH.name, Keyword.TRAMPLE.name,
+        Keyword.VIGILANCE.name, Keyword.HEXPROOF.name, Keyword.SHROUD.name,
+    )
+
