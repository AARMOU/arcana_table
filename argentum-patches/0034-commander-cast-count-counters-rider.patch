+/**
+ * `ManaSpellRider.CommanderEntersWithCastCountCounters` — Opal Palace's "If you spend this mana to
+ * cast your commander, it enters with a number of additional +1/+1 counters on it equal to the
+ * number of times it's been cast from the command zone this game."
+ *
+ * Pins: the count is the cast commander's **own** (never a partner-pair sum); it includes the cast in
+ * progress (ruling 2020-11-10); provenance — only rider mana actually spent on that commander spell
+ * counts; each rider mana spent adds its own counters (ruling 2020-11-10, Mana Reflection); a cast
+ * from hand reads the count without adding to it.
+ */
+class CommanderCastCountCountersRiderTest : FunSpec({
+
+    val rider = ManaSpellRider.CommanderEntersWithCastCountCounters()
+
+    val whitePartner = CardDefinition.creature(
+        name = "Rider Test White Partner",
+        manaCost = ManaCost.parse("{1}{W}"),
+        subtypes = setOf(Subtype("Human")),
+        power = 2,
+        toughness = 2,
+        supertypes = setOf(Supertype.LEGENDARY),
+        oracleText = "Partner",
+    ).copy(keywordAbilities = listOf(KeywordAbility.partner()))
+
+    val bluePartner = CardDefinition.creature(
+        name = "Rider Test Blue Partner",
+        manaCost = ManaCost.parse("{U}"),
+        subtypes = setOf(Subtype("Wizard")),
+        power = 1,
+        toughness = 1,
+        supertypes = setOf(Supertype.LEGENDARY),
+        oracleText = "Partner",
+    ).copy(keywordAbilities = listOf(KeywordAbility.partner()))
+
+    val squire = CardDefinition.creature(
+        name = "Rider Test Squire",
+        manaCost = ManaCost.parse("{1}{W}"),
+        subtypes = setOf(Subtype("Human")),
+        power = 1,
+        toughness = 1,
+    )
+
+    val palace = card("Rider Test Palace") {
+        typeLine = "Land"
+        activatedAbility {
+            cost = AbilityCost.Tap
+            effect = Effects.AddManaOfColorInCommanderColorIdentity(riders = setOf(rider))
+            manaAbility = true
+            timing = TimingRule.ManaAbility
+        }
+    }
+
+    val twinPalace = card("Rider Test Twin Palace") {
+        typeLine = "Land"
+        activatedAbility {
+            cost = AbilityCost.Tap
+            effect = AddManaOfChoiceEffect(ManaColorSet.CommanderIdentity, DynamicAmount.Fixed(2), riders = setOf(rider))
+            manaAbility = true
+            timing = TimingRule.ManaAbility
+        }
+    }
+
+    fun game(): Pair<GameTestDriver, EntityId> {
+        val driver = GameTestDriver()
+        driver.registerCards(listOf(whitePartner, bluePartner, squire, palace, twinPalace))
+        val players = driver.initMultiplayer(
+            decks = listOf(Deck(cards = List(98) { squire.name }), Deck(cards = List(99) { squire.name })),
+            format = Format.Commander(alwaysDivertToCommand = true),
+            commanders = listOf(whitePartner.name, whitePartner.name),
+            partners = listOf(bluePartner.name, null),
+            skipMulligans = true,
+            startingPlayer = 0,
+        )
+        driver.passPriorityUntil(Step.PRECOMBAT_MAIN)
+        return driver to players[0]
+    }
+
+    fun GameTestDriver.commander(owner: EntityId, name: String): EntityId =
+        state.getZone(ZoneKey(owner, Zone.COMMAND)).single { state.getEntity(it)?.get<CardComponent>()?.name == name }
+
+    fun GameTestDriver.setCasts(id: EntityId, casts: Int) = replaceState(
+        state.updateEntity(id) { c -> c.with(c.get<CommanderComponent>()!!.copy(castsFromCommandZone = casts)) }
+    )
+
+    fun GameTestDriver.tapFor(player: EntityId, land: CardDefinition, color: Color) {
+        val id = putPermanentOnBattlefield(player, land.name)
+        val ability = cardRegistry.requireCard(land.name).script.activatedAbilities.single()
+        submit(ActivateAbility(player, id, ability.id, manaColorChoice = color)).error.shouldBeNull()
+    }
+
+    fun GameTestDriver.plusOnes(id: EntityId): Int =
+        state.getEntity(id)?.get<CountersComponent>()?.getCount(CounterType.PLUS_ONE_PLUS_ONE) ?: 0
+
+    fun GameTestDriver.riderManaFloating(player: EntityId): Int =
+        state.getEntity(player)!!.get<ManaPoolComponent>()!!.restrictedMana.count { rider in it.riders }
+
+    fun GameTestDriver.resolveTop() {
+        bothPass()
+        state.stack.size shouldBe 0
+    }
+
+    test("rider mana on a commander's first command-zone cast: the cast counts itself, one counter") {
+        val (d, p) = game()
+        val white = d.commander(p, whitePartner.name)
+        d.tapFor(p, palace, Color.WHITE)
+        d.giveColorlessMana(p, 1)
+        d.castSpell(p, white).error.shouldBeNull()
+        d.riderManaFloating(p) shouldBe 0
+        d.resolveTop()
+        d.state.getZone(ZoneKey(p, Zone.BATTLEFIELD)) shouldContain white
+        d.plusOnes(white) shouldBe 1
+    }
+
+    test("the count is the cast commander's own, never the partner pair's sum") {
+        val (d, p) = game()
+        val white = d.commander(p, whitePartner.name)
+        val blue = d.commander(p, bluePartner.name)
+        d.setCasts(blue, 2)
