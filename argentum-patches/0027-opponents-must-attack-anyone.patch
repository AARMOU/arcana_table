+package com.wingedsheep.engine.mechanics.combat
+
+import com.wingedsheep.engine.legalactions.LegalActionEnumerator
+import com.wingedsheep.engine.state.components.battlefield.CountersComponent
+import com.wingedsheep.engine.support.GameTestDriver
+import com.wingedsheep.engine.support.TestCards
+import com.wingedsheep.sdk.core.CounterType
+import com.wingedsheep.sdk.core.Step
+import com.wingedsheep.sdk.dsl.card
+import com.wingedsheep.sdk.model.Deck
+import com.wingedsheep.sdk.scripting.AttackTax
+import com.wingedsheep.sdk.scripting.CantAttackUnlessCoAttacker
+import com.wingedsheep.sdk.scripting.GameObjectFilter
+import com.wingedsheep.sdk.scripting.OpponentsMustAttack
+import com.wingedsheep.sdk.scripting.values.DynamicAmount
+import io.kotest.core.spec.style.FunSpec
+import io.kotest.matchers.shouldBe
+import io.kotest.matchers.shouldNotBe
+
+/**
+ * [OpponentsMustAttack] — "each opponent must attack with at least one creature each combat if able"
+ * (Seeker of Slaanesh). A player-level requirement with no named defender (CR 508.1d): any one
+ * attack satisfies it, and it lapses when no creature can attack anything for free.
+ */
+class OpponentsMustAttackTest : FunSpec({
+
+    val allure = card("Test Allure") {
+        manaCost = "{3}{R}"
+        typeLine = "Enchantment"
+        oracleText = "Each opponent must attack with at least one creature each combat if able."
+        staticAbility { ability = OpponentsMustAttack }
+    }
+
+    val prison = card("Test Allure Prison") {
+        manaCost = "{2}{W}"
+        typeLine = "Enchantment"
+        oracleText = "Creatures can't attack you unless their controller pays {2} for each creature they control that's attacking you."
+        staticAbility { ability = AttackTax(DynamicAmount.Fixed(2)) }
+    }
+
+    val walker = card("Test Allure Walker") {
+        manaCost = "{3}"
+        typeLine = "Legendary Planeswalker — Test"
+        startingLoyalty = 3
+        oracleText = ""
+    }
+
+    val loner = card("Test Allure Loner") {
+        manaCost = "{1}{R}"
+        typeLine = "Creature — Cat"
+        power = 2
+        toughness = 2
+        oracleText = "This creature can't attack unless another creature also attacks."
+        staticAbility { ability = CantAttackUnlessCoAttacker(GameObjectFilter.Creature) }
+    }
+
+    fun newDriver(): GameTestDriver {
+        val driver = GameTestDriver()
+        driver.registerCards(TestCards.all)
+        driver.registerCards(listOf(allure, prison, walker, loner))
+        driver.initMirrorMatch(deck = Deck.of("Forest" to 40), skipMulligans = true, startingPlayer = 0)
+        driver.passPriorityUntil(Step.PRECOMBAT_MAIN)
+        return driver
+    }
+
+    test("declaring no attackers is rejected while a creature can attack") {
+        val driver = newDriver()
+        val bears = driver.putCreatureOnBattlefield(driver.player1, "Centaur Courser")
+        driver.removeSummoningSickness(bears)
+        driver.putPermanentOnBattlefield(driver.player2, "Test Allure")
+        driver.passPriorityUntil(Step.DECLARE_ATTACKERS)
+
+        driver.declareAttackers(driver.player1, emptyMap()).error shouldNotBe null
+        driver.declareAttackers(driver.player1, mapOf(bears to driver.player2)).error shouldBe null
+    }
+
+    test("one attacker is enough and no creature is individually mandatory") {
+        val driver = newDriver()
+        val a = driver.putCreatureOnBattlefield(driver.player1, "Centaur Courser")
+        val b = driver.putCreatureOnBattlefield(driver.player1, "Savannah Lions")
+        driver.removeSummoningSickness(a)
+        driver.removeSummoningSickness(b)
+        driver.putPermanentOnBattlefield(driver.player2, "Test Allure")
+        driver.passPriorityUntil(Step.DECLARE_ATTACKERS)
+
+        LegalActionEnumerator.create(driver.cardRegistry).enumerate(driver.state, driver.player1)
+            .single { it.actionType == "DeclareAttackers" }.mandatoryAttackers shouldBe null
+        driver.declareAttackers(driver.player1, mapOf(b to driver.player2)).error shouldBe null
+    }
+
+    test("attacking a planeswalker satisfies it — no defender is named") {
+        val driver = newDriver()
+        val bears = driver.putCreatureOnBattlefield(driver.player1, "Centaur Courser")
+        driver.removeSummoningSickness(bears)
+        driver.putPermanentOnBattlefield(driver.player2, "Test Allure")
+        val pw = driver.putPermanentOnBattlefield(driver.player2, "Test Allure Walker")
+        driver.replaceState(
+            driver.state.updateEntity(pw) { it.with(CountersComponent().withAdded(CounterType.LOYALTY, 3)) }
+        )
+        driver.passPriorityUntil(Step.DECLARE_ATTACKERS)
+
+        driver.declareAttackers(driver.player1, mapOf(bears to pw)).error shouldBe null
+    }
+
+    test("an attack tax lifts the requirement — nobody has to pay to obey it (CR 508.1d)") {
+        val driver = newDriver()
+        val bears = driver.putCreatureOnBattlefield(driver.player1, "Centaur Courser")
+        driver.removeSummoningSickness(bears)
+        driver.putPermanentOnBattlefield(driver.player2, "Test Allure")
+        driver.putPermanentOnBattlefield(driver.player2, "Test Allure Prison")
+        driver.passPriorityUntil(Step.DECLARE_ATTACKERS)
+
+        driver.declareAttackers(driver.player1, emptyMap()).error shouldBe null
+    }
+
+    test("the controller is under no requirement on their own turn") {
+        val driver = newDriver()
+        val bears = driver.putCreatureOnBattlefield(driver.player1, "Centaur Courser")
+        driver.removeSummoningSickness(bears)
+        driver.putPermanentOnBattlefield(driver.player1, "Test Allure")
+        driver.passPriorityUntil(Step.DECLARE_ATTACKERS)
+
+        driver.declareAttackers(driver.player1, emptyMap()).error shouldBe null
+    }
+
+    test("a lone creature that can't attack alone isn't able; with a co-attacker it is") {
+        val alone = newDriver()
+        val cat = alone.putCreatureOnBattlefield(alone.player1, "Test Allure Loner")
+        alone.removeSummoningSickness(cat)
+        alone.putPermanentOnBattlefield(alone.player2, "Test Allure")
+        alone.passPriorityUntil(Step.DECLARE_ATTACKERS)
+        alone.declareAttackers(alone.player1, emptyMap()).error shouldBe null
+
+        val paired = newDriver()
+        val cat2 = paired.putCreatureOnBattlefield(paired.player1, "Test Allure Loner")
+        val lions = paired.putCreatureOnBattlefield(paired.player1, "Savannah Lions")
+        paired.removeSummoningSickness(cat2)
+        paired.removeSummoningSickness(lions)
+        paired.putPermanentOnBattlefield(paired.player2, "Test Allure")
+        paired.passPriorityUntil(Step.DECLARE_ATTACKERS)
+        paired.declareAttackers(paired.player1, emptyMap()).error shouldNotBe null
+    }
+})
