diff --git a/rules-engine/src/test/kotlin/com/wingedsheep/engine/scenarios/FreeCastOnceEachTurnTest.kt b/rules-engine/src/test/kotlin/com/wingedsheep/engine/scenarios/FreeCastOnceEachTurnTest.kt
new file mode 100644
index 00000000000..5307b1d5adb
--- /dev/null
+++ b/rules-engine/src/test/kotlin/com/wingedsheep/engine/scenarios/FreeCastOnceEachTurnTest.kt
@@ -0,0 +1,168 @@
+package com.wingedsheep.engine.scenarios
+
+import com.wingedsheep.engine.core.CastSpell
+import com.wingedsheep.engine.state.components.battlefield.MayCastWithoutPayingCostUsedThisTurnComponent
+import com.wingedsheep.engine.support.GameTestDriver
+import com.wingedsheep.engine.support.TestCards
+import com.wingedsheep.sdk.core.Step
+import com.wingedsheep.sdk.core.Zone
+import com.wingedsheep.sdk.dsl.Effects
+import com.wingedsheep.sdk.dsl.card
+import com.wingedsheep.sdk.model.Deck
+import com.wingedsheep.sdk.model.EntityId
+import com.wingedsheep.sdk.scripting.GameObjectFilter
+import com.wingedsheep.sdk.scripting.MayCastWithoutPayingManaCost
+import com.wingedsheep.sdk.scripting.predicates.CardPredicate
+import io.kotest.assertions.withClue
+import io.kotest.core.spec.style.FunSpec
+import io.kotest.matchers.shouldBe
+import io.kotest.matchers.shouldNotBe
+
+/**
+ * `MayCastWithoutPayingManaCost(oncePerTurn = true, onAnyTurn = true)`: "Once each turn, you may
+ * pay {0} rather than pay the mana cost for a colorless spell you cast from your hand" (Darksteel
+ * Monolith). The single use exists on every turn, opponents' included, and refreshes each turn.
+ * With `duringYourTurnOnly` the permission has its "once during each of your turns" meaning (Zaffai and
+ * the Tempests, One with the Multiverse). Neither form changes a spell's timing.
+ */
+class FreeCastOnceEachTurnTest : FunSpec({
+
+    val colorlessFromHand = GameObjectFilter.Any.withCardPredicate(CardPredicate.IsColorless)
+
+    val anyTurnSource = card("Any Turn Free Caster") {
+        manaCost = "{8}"
+        typeLine = "Artifact"
+        oracleText = "Once each turn, you may pay {0} rather than pay the mana cost for a colorless spell you cast from your hand."
+        staticAbility {
+            ability = MayCastWithoutPayingManaCost(
+                controllerOnly = true,
+                oncePerTurn = true,
+                onAnyTurn = true,
+                spellFilter = colorlessFromHand,
+                fromZones = setOf(Zone.HAND),
+            )
+        }
+    }
+    val ownTurnSource = card("Own Turn Free Caster") {
+        manaCost = "{8}"
+        typeLine = "Artifact"
+        oracleText = "Once during each of your turns, you may cast a colorless spell from your hand without paying its mana cost."
+        staticAbility {
+            ability = MayCastWithoutPayingManaCost(
+                controllerOnly = true,
+                oncePerTurn = true,
+                duringYourTurnOnly = true,
+                spellFilter = colorlessFromHand,
+                fromZones = setOf(Zone.HAND),
+            )
+        }
+    }
+    val colorlessInstant = card("Colorless Test Instant") {
+        manaCost = "{7}"
+        typeLine = "Instant"
+        oracleText = "You gain 1 life."
+        spell { effect = Effects.GainLife(1) }
+    }
+    val colorlessSorcery = card("Colorless Test Sorcery") {
+        manaCost = "{7}"
+        typeLine = "Sorcery"
+        oracleText = "You gain 1 life."
+        spell { effect = Effects.GainLife(1) }
+    }
+    val blueInstant = card("Blue Test Instant") {
+        manaCost = "{6}{U}"
+        typeLine = "Instant"
+        oracleText = "You gain 1 life."
+        spell { effect = Effects.GainLife(1) }
+    }
+
+    fun newDriver(): Pair<GameTestDriver, EntityId> {
+        val driver = GameTestDriver()
+        driver.registerCards(
+            TestCards.all + listOf(anyTurnSource, ownTurnSource, colorlessInstant, colorlessSorcery, blueInstant)
+        )
+        driver.initMirrorMatch(deck = Deck.of("Swamp" to 40), skipMulligans = true, startingPlayer = 0)
+        val me = driver.activePlayer!!
+        driver.passPriorityUntil(Step.PRECOMBAT_MAIN)
+        return driver to me
+    }
+
+    /** Advance to the opponent's precombat main phase and let the opponent pass, so [me] holds priority. */
+    fun GameTestDriver.toOpponentsMainWithPriority(me: EntityId) {
+        val opponent = getOpponent(me)
+        passPriorityUntil(Step.PRECOMBAT_MAIN, opponent)
+        passPriority(opponent)
+        withClue("the non-active player now holds priority on the opponent's turn") {
+            state.priorityPlayerId shouldBe me
+        }
+    }
+
+    fun GameTestDriver.freeCast(player: EntityId, cardId: EntityId) =
+        submit(CastSpell(playerId = player, cardId = cardId, useWithoutPayingManaCost = true))
+
+    test("the once-each-turn use is available during an opponent's turn") {
+        val (driver, me) = newDriver()
+        driver.putPermanentOnBattlefield(me, "Any Turn Free Caster")
+        val instant = driver.putCardInHand(me, "Colorless Test Instant")
+        driver.toOpponentsMainWithPriority(me)
+        withClue("no lands: the cast only succeeds because it is free") {
+            driver.freeCast(me, instant).error shouldBe null
+        }
+    }
+
+    test("it is used up for the rest of that turn and refreshes on the next turn") {
+        val (driver, me) = newDriver()
+        val source = driver.putPermanentOnBattlefield(me, "Any Turn Free Caster")
+        val first = driver.putCardInHand(me, "Colorless Test Instant")
+        val second = driver.putCardInHand(me, "Colorless Test Instant")
+        val third = driver.putCardInHand(me, "Colorless Test Instant")
+
+        driver.freeCast(me, first).error shouldBe null
+        driver.state.getEntity(source)?.get<MayCastWithoutPayingCostUsedThisTurnComponent>() shouldNotBe null
+        driver.bothPass()
+        withClue("a second free cast in the same turn is refused") {
+            driver.freeCast(me, second).error shouldNotBe null
+        }
+
+        driver.toOpponentsMainWithPriority(me)
+        withClue("the next turn (the opponent's) has a fresh use") {
+            driver.freeCast(me, second).error shouldBe null
+        }
+        driver.bothPass()
+        driver.passPriority(driver.getOpponent(me))
+        withClue("...and only one") {
+            driver.freeCast(me, third).error shouldNotBe null
+        }
+    }
+
+    test("duringYourTurnOnly limits the use to the caster's own turns") {
+        val (driver, me) = newDriver()
+        driver.putPermanentOnBattlefield(me, "Own Turn Free Caster")
+        val instant = driver.putCardInHand(me, "Colorless Test Instant")
+        driver.toOpponentsMainWithPriority(me)
+        driver.freeCast(me, instant).error shouldNotBe null
+    }
+
+    test("timing is unchanged: a sorcery can't be cast this way on an opponent's turn") {
+        val (driver, me) = newDriver()
+        driver.putPermanentOnBattlefield(me, "Any Turn Free Caster")
+        val sorcery = driver.putCardInHand(me, "Colorless Test Sorcery")
+        driver.toOpponentsMainWithPriority(me)
+        driver.freeCast(me, sorcery).error shouldNotBe null
+    }
+
+    test("filters and controller still apply: colored spells and the opponent get nothing") {
+        val (driver, me) = newDriver()
+        driver.putPermanentOnBattlefield(me, "Any Turn Free Caster")
+        val blue = driver.putCardInHand(me, "Blue Test Instant")
+        driver.freeCast(me, blue).error shouldNotBe null
+
+        val opponent = driver.getOpponent(me)
+        val theirs = driver.putCardInHand(opponent, "Colorless Test Instant")
+        driver.passPriority(me)
+        withClue("the opponent holds priority on my turn") { driver.state.priorityPlayerId shouldBe opponent }
+        withClue("controllerOnly: the source's opponent can't use it") {
+            driver.freeCast(opponent, theirs).error shouldNotBe null
+        }
+    }
+})
