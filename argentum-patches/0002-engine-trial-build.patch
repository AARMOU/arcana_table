@@ -0,0 +1,26 @@
+package com.arcanatable.export
+
+import com.wingedsheep.mtg.sets.definitions.por.PortalSet
+import com.wingedsheep.sdk.tooling.CardExporter
+import com.wingedsheep.sdk.tooling.CardLoader
+import java.io.File
+
+/**
+ * Writes Portal (POR) as card DATA for Arcana's in-app engine trial: one compact JSON definition
+ * per line, exactly as Argentum's own CardExporter produces it, then reloads every line with
+ * CardLoader.fromJsonPreservingIds to prove the round trip before anything ships.
+ */
+fun main(args: Array<String>) {
+    val outDir = File(args.firstOrNull() ?: "arcana-export-out").apply { mkdirs() }
+    val cards = (PortalSet.cards + PortalSet.basicLands).distinctBy { it.name }
+    val lines = cards.map { CardExporter.exportToCompactJson(it).replace("\n", "") }
+    var failures = 0
+    lines.zip(cards).forEach { (line, card) ->
+        val back = runCatching { CardLoader.fromJsonPreservingIds(line) }.getOrNull()
+        if (back == null || back.name != card.name) { failures++; System.err.println("Round trip failed: ${card.name}") }
+    }
+    val out = File(outDir, "por-cards.jsonl")
+    out.writeText(lines.joinToString("\n") + "\n")
+    println("ARCANA-EXPORT cards=${cards.size} bytes=${out.length()} roundTripFailures=$failures file=${out.absolutePath}")
+    if (failures > 0) kotlin.system.exitProcess(2)
+}
diff --git a/buildSrc/src/main/kotlin/arcana-android-target.gradle.kts b/buildSrc/src/main/kotlin/arcana-android-target.gradle.kts
new file mode 100644
index 00000000000..b07af250d51
--- /dev/null
+++ b/buildSrc/src/main/kotlin/arcana-android-target.gradle.kts
@@ -0,0 +1,24 @@
+// Arcana Table: the jars this build produces run inside an Android app, so every main source set is
+// compiled for Java 17 bytecode against the Java 17 API (no newer-JDK calls), whatever JDK the build
+// itself runs on. JVM-only test sources keep the toolchain's API: some use newer JDK calls such as
+// Thread.threadId(), and they never ship to Android.
+//
+// This lives in its own file, applied by one line in kotlin-jvm.gradle.kts's plugins block, so that
+// upstream edits to that convention plugin (toolchain bumps, test properties) cannot conflict with it.
+package buildsrc.convention
+
+import org.jetbrains.kotlin.gradle.dsl.JvmTarget
+import org.jetbrains.kotlin.gradle.dsl.KotlinJvmProjectExtension
+import org.jetbrains.kotlin.gradle.tasks.KotlinCompile
+
+pluginManager.withPlugin("org.jetbrains.kotlin.jvm") {
+    extensions.configure<KotlinJvmProjectExtension> {
+        compilerOptions { jvmTarget.set(JvmTarget.JVM_17) }
+    }
+}
+
+tasks.withType<JavaCompile>().configureEach { options.release.set(17) }
+
+tasks.withType<KotlinCompile>().configureEach {
+    if (!name.contains("Test")) compilerOptions.freeCompilerArgs.add("-Xjdk-release=17")
+}
