+package com.wingedsheep.ai.engine
+
+import com.wingedsheep.ai.insight.AiActionOption
+import com.wingedsheep.ai.insight.AiInsightSink
+import com.wingedsheep.ai.puzzles.advanceToPriority
+import com.wingedsheep.engine.core.CastSpell
+import com.wingedsheep.engine.core.GameAction
+import com.wingedsheep.engine.core.PassPriority
+import com.wingedsheep.engine.state.components.identity.CardComponent
+import com.wingedsheep.engine.support.ScenarioTestBase
+import com.wingedsheep.sdk.core.Step
+import com.wingedsheep.sdk.core.Zone
+import com.wingedsheep.sdk.dsl.Effects
+import com.wingedsheep.sdk.dsl.card
+import com.wingedsheep.sdk.scripting.AbilityCost
+import com.wingedsheep.sdk.scripting.TimingRule
+import com.wingedsheep.sdk.scripting.filters.unified.TargetFilter
+import io.kotest.assertions.withClue
+import io.kotest.matchers.shouldBe
+import io.kotest.matchers.shouldNotBe
+
+/**
+ * [AiProfile.manaHeldOnlyForInstants], which ships in [AiProfile.CURRENT] (Arcana patch 0035)
+ * together with [AiProfile.permanentCastIsNotCardLoss].
+ *
+ * The failure it fixes comes from the 2026-11-02 Eldrazi Incursion AI mirror (seed 1). Both seats
+ * passed every main phase for twenty turns with Talismans and Herald's Horn castable. Each scored
+ * just below passing because the flat tapped-land charge in `BoardPresence` cost more than a
+ * non-creature permanent is worth without card knowledge. The controls show that the charge still
+ * does its job when an affordable instant-speed card in hand needs the mana on the opponent's turn.
+ */
+class ManaHeldOnlyForInstantsTest : ScenarioTestBase() {
+
+    /** A two-mana "add one mana" rock. */
+    private val rock = card("Idle Mana Test Rock") {
+        manaCost = "{2}"
+        colorIdentity = ""
+        typeLine = "Artifact"
+        oracleText = "{T}: Add {C}."
+        activatedAbility {
+            cost = AbilityCost.Tap
+            effect = Effects.AddColorlessMana(1)
+            manaAbility = true
+            timing = TimingRule.ManaAbility
+        }
+    }
+
+    /** A three-mana permanent that does nothing. */
+    private val trinket = card("Idle Mana Test Trinket") {
+        manaCost = "{3}"
+        colorIdentity = ""
+        typeLine = "Artifact"
+    }
+
+    /** The six-drop the rock is played beside: never castable on three lands. */
+    private val colossus = card("Idle Mana Test Colossus") {
+        manaCost = "{5}{R}"
+        typeLine = "Creature — Giant"
+        power = 6
+        toughness = 6
+    }
+
+    /** An instant-speed answer with no target on our own turn, so it's never a candidate here. */
+    private fun counterspell(name: String, cost: String) = card(name) {
+        manaCost = cost
+        typeLine = "Instant"
+        oracleText = "Counter target spell."
+        spell {
+            target(TargetFilter.SpellOnStack)
+            effect = Effects.CounterSpell()
+        }
+    }
+
+    private val denial = counterspell("Idle Mana Test Denial", "{1}{R}{R}")
+    private val cheapDenial = counterspell("Idle Mana Test Snap", "{R}")
+    private val dearDenial = counterspell("Idle Mana Test Refusal", "{3}{R}{R}")
+
+    init {
+        cardRegistry.register(listOf(rock, trinket, colossus, denial, cheapDenial, dearDenial))
+    }
+
+    /** Our precombat main on turn 6: three untapped Mountains and [hand]. */
+    private fun board(vararg hand: String): TestGame = scenario().withPlayers()
+        .withRngSeed(RNG_SEED)
+        .withTurnNumber(6)
+        .withLandsOnBattlefield(1, "Mountain", 3)
+        .apply { hand.forEach { withCardInHand(1, it) } }
+        .apply { repeat(6) { withCardInLibrary(1, "Mountain") } }
+        .apply { repeat(6) { withCardInLibrary(2, "Mountain") } }
+        .build()
+        .advanceToPriority(1, Step.PRECOMBAT_MAIN)
+
+    /** The action [profile] takes, and the options it scored, for the failure message. */
+    private fun TestGame.choose(profile: AiProfile = AiProfile.CURRENT): Pair<GameAction, List<AiActionOption>> {
+        var options = emptyList<AiActionOption>()
+        val sink = AiInsightSink { _, insight -> if (insight.options.size > 1) options = insight.options }
+        val action = AIPlayer.create(cardRegistry, player1Id, profile, insightSink = sink).chooseAction(state)
+        return action to options
+    }
+
+    private fun TestGame.castName(action: GameAction): String? =
+        (action as? CastSpell)?.let { state.getEntity(it.cardId)?.get<CardComponent>()?.name }
+
+    /** Assert that [AiProfile.CURRENT] casts [expected] here, naming every scored option if not. */
+    private fun TestGame.shouldCast(expected: String) {
+        val (action, options) = choose()
+        withClue("options: $options") { castName(action) shouldBe expected }
+    }
+
+    init {
+        // ── The fix ──
+
+        test("casts a two-mana rock beside a six-drop it cannot cast, rather than passing") {
+            val game = board("Idle Mana Test Rock", "Idle Mana Test Colossus")
+            val (action, options) = game.choose()
+            withClue("options: $options") {
+                game.castName(action) shouldBe "Idle Mana Test Rock"
+            }
+        }
+
+        test("the frozen v0 profile still passes there: the change is the profile's, not the evaluator's") {
+            val game = board("Idle Mana Test Rock", "Idle Mana Test Colossus")
+            game.choose(AiProfile.LEGACY_V0).first shouldBe PassPriority(game.player1Id)
+        }
+
+        test("a cheap non-creature permanent is deployed when nothing in hand wants the mana") {
+            board("Idle Mana Test Trinket", "Idle Mana Test Colossus").shouldCast("Idle Mana Test Trinket")
+        }
+
+        // ── What the charge is still for ──
+
+        test("an affordable instant keeps its mana: the do-nothing permanent is not cast") {
+            val game = board("Idle Mana Test Trinket", "Idle Mana Test Denial")
+            val (action, options) = game.choose()
+            withClue("options: $options") {
+                game.castName(action) shouldNotBe "Idle Mana Test Trinket"
+            }
+        }
+
+        test("an instant still castable from the lands left over does not hold them all") {
+            // One Mountain stays up for the {R} answer after the rock taps two.
+            board("Idle Mana Test Rock", "Idle Mana Test Snap").shouldCast("Idle Mana Test Rock")
+        }
+
+        test("an instant it could not afford on three lands holds nothing") {
+            board("Idle Mana Test Trinket", "Idle Mana Test Refusal").shouldCast("Idle Mana Test Trinket")
+        }
+
+        // ── Land drops are untouched ──
+
+        test("the land drop is still made the turn the rock is cast") {
+            val game = board("Mountain", "Idle Mana Test Rock", "Idle Mana Test Colossus")
+            val ai = AIPlayer.create(cardRegistry, game.player1Id, AiProfile.CURRENT)
+            val taken = mutableListOf<GameAction>()
+            repeat(6) {
+                if (game.state.stack.isNotEmpty()) game.resolveStack()
+                if (game.state.step != Step.PRECOMBAT_MAIN || game.state.priorityPlayerId != game.player1Id) return@repeat
+                val action = ai.chooseAction(game.state)
+                if (action is PassPriority) return@repeat
+                taken += action
+                game.execute(action).error shouldBe null
+            }
+            withClue("actions: $taken") {
+                game.findPermanents("Mountain").size shouldBe 4
+                game.isOnBattlefield("Idle Mana Test Rock") shouldBe true
+                game.state.getZone(game.player1Id, Zone.HAND).size shouldBe 1
+            }
+        }
+    }
+
+    private companion object {
+        const val RNG_SEED = 35L
+    }
+}
