+    /**
+     * What the evaluator charged for the lands [action] tapped, refunded when that mana was not
+     * holding anything up ([AiProfile.manaHeldOnlyForInstants]).
+     *
+     * Measured with the evaluator, as [deploymentCredit] is:
+     * `evaluate(leaf with the spent lands untapped) − evaluate(leaf)`. Whichever land model the
+     * profile runs, the refund is exactly the charge it applied. If that model already refunded
+     * idle mana, the difference is zero and nothing is counted twice.
+     *
+     * The conditions:
+     *  - **A cast from our own main phase with the stack empty.** At sorcery timing, mana this
+     *    turn's main phases don't spend is gone at end of turn.
+     *  - **The lands left untapped still cast every instant-speed card the root's untapped lands
+     *    could.** Instants and flash cards in hand, other than the one being cast, are the only
+     *    reason to keep mana for the opponent's turn. One we couldn't afford anyway (mana value
+     *    above the untapped land count) holds nothing. A tap that breaks that window keeps its
+     *    full charge.
+     *  - **Lands only, mana value against land count, colours ignored.** These are the same
+     *    approximations [BoardPresence]'s land-sequencing term makes, for the same reason: a
+     *    solver call per candidate is not affordable.
+     *  - **Never negative.**
+     */
+    private fun idleManaCredit(
+        root: GameState,
+        action: LegalAction,
+        leaf: GameState,
+        playerId: EntityId,
+    ): Double {
+        if (!manaHeldOnlyForInstants) return 0.0
+        val cast = action.action as? CastSpell ?: return 0.0
+        if (!root.isActiveTurnFor(playerId) || root.stack.isNotEmpty()) return 0.0
+        if (root.step != Step.PRECOMBAT_MAIN && root.step != Step.POSTCOMBAT_MAIN) return 0.0
+        val projected = root.projectedState
+        val untappedAtRoot = projected.getBattlefieldControlledBy(playerId).filter {
+            projected.hasType(it, "LAND") && root.getEntity(it)?.has<TappedComponent>() != true
+        }
+        val spent = untappedAtRoot.filter { leaf.getEntity(it)?.has<TappedComponent>() == true }
+        if (spent.isEmpty()) return 0.0
+        val heldFor = root.getZone(playerId, Zone.HAND).asSequence()
+            .filter { it != cast.cardId }
+            .mapNotNull { root.getEntity(it)?.get<CardComponent>() }
+            .filter { !it.isLand && (it.typeLine.isInstant || Keyword.FLASH in it.baseKeywords) }
+            .map { it.manaValue }
+            .filter { it <= untappedAtRoot.size }
+            .maxOrNull()
+        if (heldFor != null && untappedAtRoot.size - spent.size < heldFor) return 0.0
+        val restored = spent.fold(leaf) { acc, id -> acc.updateEntity(id) { it.without<TappedComponent>() } }
+        val charge = evaluator.evaluate(restored, restored.projectedState, playerId) -
+            evaluator.evaluate(leaf, leaf.projectedState, playerId)
+        return charge.coerceAtLeast(0.0)
+    }
+
