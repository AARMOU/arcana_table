--- /dev/null
+++ b/mtg-sdk/src/test/kotlin/com/wingedsheep/sdk/core/ColorlessHybridManaSdkTest.kt
@@ -0,0 +1,69 @@
+package com.wingedsheep.sdk.core
+
+import io.kotest.assertions.throwables.shouldThrow
+import io.kotest.core.spec.style.StringSpec
+import io.kotest.matchers.shouldBe
+import io.kotest.matchers.collections.shouldContainExactly
+import kotlinx.serialization.json.Json
+
+/** SDK-only validation; rules-engine mana allocation and Android runtime are separate gates. */
+class ColorlessHybridManaSdkTest : StringSpec({
+    val colors = listOf(Color.WHITE, Color.BLUE, Color.BLACK, Color.RED, Color.GREEN)
+
+    "all five real colorless-hybrid symbols parse as typed single-mana hybrid costs" {
+        for (color in colors) {
+            val cost = ManaCost.parse("{C/${color.symbol}}")
+            cost.symbols shouldContainExactly listOf(ManaSymbol.ColorlessHybrid(color))
+            cost.cmc shouldBe 1
+            cost.colorlessAmount shouldBe 0
+            cost.colors shouldBe setOf(color)
+        }
+    }
+
+    "Ulalek has the printed five hybrid pips, one colored devotion pip per color and mana value five" {
+        val printed = "{C/W}{C/U}{C/B}{C/R}{C/G}"
+        val cost = ManaCost.parse(printed)
+        cost.cmc shouldBe 5
+        cost.symbols.size shouldBe 5
+        cost.colors shouldBe colors.toSet()
+        cost.coloredSymbolCount(colors.toSet()) shouldBe 5
+        colors.forEach { cost.coloredSymbolCount(setOf(it)) shouldBe 1 }
+        cost.toString() shouldBe printed
+    }
+
+    "colorless hybrid does not collapse into colorless or generic and retains its identity" {
+        ManaCost.parse("{C/W}") shouldBe ManaCost.of(ManaSymbol.ColorlessHybrid(Color.WHITE))
+        ManaCost.parse("{C/W}") shouldBe ManaCost.parse("{C/W}")
+        (ManaCost.parse("{C/W}") == ManaCost.parse("{C}")) shouldBe false
+        (ManaCost.parse("{C/W}") == ManaCost.parse("{1}")) shouldBe false
+        (ManaCost.parse("{C/W}") == ManaCost.parse("{W}")) shouldBe false
+    }
+
+    "colorless hybrid survives the SDK persistence wire encoding" {
+        val cost = ManaCost.parse("{2}{C/W}{C/U}{C}{W}")
+        val json = Json.encodeToString(ManaCost.serializer(), cost)
+        Json.decodeFromString(ManaCost.serializer(), json) shouldBe cost
+    }
+
+    "paying or reducing a hybrid pip can select either actual colorless or its specific color" {
+        val hybrid = ManaCost.parse("{C/W}")
+        hybrid.subtract(ManaCost.parse("{W}")) shouldBe ManaCost.ZERO
+        hybrid.subtract(ManaCost.parse("{C}")) shouldBe ManaCost.ZERO
+        ManaCost.parse("{W}").subtract(hybrid) shouldBe ManaCost.ZERO
+        ManaCost.parse("{C}").subtract(hybrid) shouldBe ManaCost.ZERO
+        ManaCost.parse("{U}").subtract(hybrid) shouldBe ManaCost.parse("{U}")
+    }
+
+    "mana of any type relaxation removes the hybrid requirement without rewriting printed cost" {
+        val hybrid = ManaCost.parse("{C/W}")
+        hybrid.relaxColors() shouldBe ManaCost.parse("{1}")
+        hybrid.relaxColoredRequirements() shouldBe ManaCost.parse("{1}")
+        hybrid.toString() shouldBe "{C/W}"
+    }
+
+    "invalid colorless hybrids and phyrexian hybrids do not parse as legal pips" {
+        for (malformed in listOf("{C/P}", "{C/C}", "{C/Z}", "{C/W/P}")) {
+            shouldThrow<IllegalArgumentException> { ManaCost.parse(malformed) }
+        }
+    }
+})
