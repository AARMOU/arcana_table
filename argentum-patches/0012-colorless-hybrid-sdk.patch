diff --git a/mtg-sdk/src/test/kotlin/com/wingedsheep/sdk/core/ColorlessHybridManaSdkTest.kt b/mtg-sdk/src/test/kotlin/com/wingedsheep/sdk/core/ColorlessHybridManaSdkTest.kt
