+    /**
+     * "For each opponent, … up to one target creature that player controls" ties each target to the
+     * player it was chosen for: a target that player no longer controls is illegal at resolution
+     * (CR 608.2b), and only that one — the other players' targets still resolve. Reads the
+     * controllers recorded as the targets were chosen ([TargetsComponent.targetControllers]); a
+     * target with no recorded controller is left to the other checks.
+     */
+    private fun targetsLeftTheirPlayer(
+        projected: ProjectedState,
+        state: GameState,
+        targets: List<ChosenTarget>,
+        targetRequirements: List<TargetRequirement>,
+        targetControllers: Map<EntityId, EntityId>,
+    ): Set<Int> {
+        if (targetControllers.isEmpty()) return emptySet()
+        return targets.indices.filter { index ->
+            val target = targets[index] as? ChosenTarget.Permanent ?: return@filter false
+            val requirement = getRequirementForTargetIndex(index, targetRequirements) ?: return@filter false
+            if (!TargetsComponent.isPerPlayerDistribution(requirement)) return@filter false
+            val chosenFor = targetControllers[target.entityId] ?: return@filter false
+            val now = projected.getController(target.entityId)
+                ?: state.getEntity(target.entityId)?.get<ControllerComponent>()?.playerId
+            now != chosenFor
+        }.toSet()
+    }
