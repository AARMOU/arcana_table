@@ -0,0 +1,121 @@
+package com.wingedsheep.engine.targeting
+
+import com.wingedsheep.engine.state.components.identity.ControllerComponent
+import com.wingedsheep.engine.state.components.stack.ChosenTarget
+import com.wingedsheep.engine.support.GameTestDriver
+import com.wingedsheep.engine.support.TestCards
+import com.wingedsheep.sdk.core.Color
+import com.wingedsheep.sdk.core.Step
+import com.wingedsheep.sdk.dsl.DynamicAmounts
+import com.wingedsheep.sdk.dsl.Effects
+import com.wingedsheep.sdk.dsl.card
+import com.wingedsheep.sdk.model.Deck
+import com.wingedsheep.sdk.model.EntityId
+import com.wingedsheep.sdk.scripting.filters.unified.TargetFilter
+import com.wingedsheep.sdk.scripting.references.Player
+import com.wingedsheep.sdk.scripting.targets.EffectTarget
+import io.kotest.assertions.withClue
+import io.kotest.core.spec.style.FunSpec
+import io.kotest.matchers.nulls.shouldBeNull
+import io.kotest.matchers.shouldBe
+
+/**
+ * "For each opponent, gain control of up to one target creature that player controls" ties each
+ * target to the opponent it was chosen for. If that opponent no longer controls it when the spell
+ * resolves, that target is illegal (CR 608.2b) and only that one: the other opponents' targets
+ * still resolve. A creature that merely stays opponent-controlled (moved from one opponent to
+ * another) is still illegal, which the filter alone can't see.
+ */
+class PerPlayerTargetBindingTest : FunSpec({
+
+    val bear = card("Binding Test Bear") {
+        manaCost = "{1}{G}"
+        typeLine = "Creature — Bear"
+        power = 2
+        toughness = 2
+    }
+
+    val theft = card("Binding Test Theft") {
+        manaCost = "{U}"
+        typeLine = "Sorcery"
+        spell {
+            targets(
+                TargetFilter.CreatureOpponentControls,
+                optional = true,
+                dynamicMaxCount = DynamicAmounts.playerCount(Player.EachOpponent),
+                differentControllers = true,
+            )
+            effect = Effects.ForEachTarget(Effects.GainControl(EffectTarget.ContextTarget(0)))
+        }
+    }
+
+    data class Table(val driver: GameTestDriver, val you: EntityId, val foe1: EntityId, val foe2: EntityId)
+
+    fun table(): Table {
+        val driver = GameTestDriver()
+        driver.registerCards(TestCards.all + listOf(bear, theft))
+        val (you, foe1, foe2) = driver.initMultiplayer(decks = List(3) { Deck.of("Forest" to 40) })
+        driver.passPriorityUntil(Step.PRECOMBAT_MAIN, activePlayer = you)
+        return Table(driver, you, foe1, foe2)
+    }
+
+    fun GameTestDriver.moveControl(creature: EntityId, to: EntityId) =
+        replaceState(state.updateEntity(creature) { it.with(ControllerComponent(to)) })
+
+    fun GameTestDriver.castTheftAt(caster: EntityId, creatures: List<EntityId>) {
+        val spell = putCardInHand(caster, "Binding Test Theft")
+        giveMana(caster, Color.BLUE)
+        castSpellWithTargets(caster, spell, creatures.map { ChosenTarget.Permanent(it) }).error.shouldBeNull()
+    }
+
+    /** Control-changing effects are continuous (layer 2), so read the projected controller. */
+    fun GameTestDriver.controllerOf(creature: EntityId) = state.projectedState.getController(creature)
+
+    fun GameTestDriver.resolveStack() {
+        var guard = 0
+        while (state.stack.isNotEmpty() && guard++ < 10) passPriority(state.priorityPlayerId!!)
+        state.stack.isEmpty() shouldBe true
+    }
+
+    test("both targets still controlled by the opponents they were chosen for: both stolen") {
+        val (d, you, foe1, foe2) = table()
+        val a = d.putCreatureOnBattlefield(foe1, "Binding Test Bear")
+        val b = d.putCreatureOnBattlefield(foe2, "Binding Test Bear")
+        d.castTheftAt(you, listOf(a, b))
+        d.resolveStack()
+        d.controllerOf(a) shouldBe you
+        d.controllerOf(b) shouldBe you
+    }
+
+    test("a target moved to the other opponent is illegal, and the other target still resolves") {
+        val (d, you, foe1, foe2) = table()
+        val a = d.putCreatureOnBattlefield(foe1, "Binding Test Bear")
+        val b = d.putCreatureOnBattlefield(foe2, "Binding Test Bear")
+        d.castTheftAt(you, listOf(a, b))
+        d.moveControl(a, foe2)
+        d.resolveStack()
+        withClue("chosen for foe1, now controlled by foe2: illegal, not stolen") {
+            d.controllerOf(a) shouldBe foe2
+        }
+        d.controllerOf(b) shouldBe you
+    }
+
+    test("a single target moved between opponents makes the spell do nothing") {
+        val (d, you, foe1, foe2) = table()
+        val a = d.putCreatureOnBattlefield(foe1, "Binding Test Bear")
+        d.castTheftAt(you, listOf(a))
+        d.moveControl(a, foe2)
+        d.resolveStack()
+        d.controllerOf(a) shouldBe foe2
+    }
+
+    test("a target moved away and back to its opponent before resolution is legal again") {
+        val (d, you, foe1, foe2) = table()
+        val a = d.putCreatureOnBattlefield(foe1, "Binding Test Bear")
+        d.castTheftAt(you, listOf(a))
+        d.moveControl(a, foe2)
+        d.moveControl(a, foe1)
+        d.resolveStack()
+        d.controllerOf(a) shouldBe you
+    }
+})
