             else "the number of extra turns ${player.description} has begun this game"
     }
 
+    /**
+     * How many times [player] has cast a commander from the command zone this game. The count
+     * includes the current cast once it is resolving, including a cast that is later countered;
+     * partner commanders are summed for their owner (CR 903.8).
+     */
+    @SerialName("CommanderCastsFromCommandZone")
+    @Serializable
+    data class CommanderCastsFromCommandZone(val player: Player = Player.You) : DynamicAmount {
+        override val description: String =
