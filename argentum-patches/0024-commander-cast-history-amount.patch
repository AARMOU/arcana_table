+package com.wingedsheep.engine.scenarios
+
+import com.wingedsheep.engine.core.CastSpell
+import com.wingedsheep.engine.handlers.EffectContext
+import com.wingedsheep.engine.state.ZoneKey
+import com.wingedsheep.engine.state.components.identity.CommanderComponent
+import com.wingedsheep.engine.support.ScenarioTestBase
+import com.wingedsheep.sdk.core.Phase
+import com.wingedsheep.sdk.core.Step
+import com.wingedsheep.sdk.core.Zone
+import com.wingedsheep.sdk.dsl.DynamicAmounts
+import com.wingedsheep.sdk.dsl.card
+import com.wingedsheep.sdk.model.EntityId
+import io.kotest.matchers.shouldBe
+
+class CommanderCastsFromCommandZoneTest : ScenarioTestBase() {
+    private val commander = card("Commander Cast Count Test") {
+        manaCost = "{0}"
+        typeLine = "Legendary Creature — Test"
+        power = 1
+        toughness = 1
+    }
+
+    private fun amount(game: TestGame, player: EntityId): Int =
+        game.services.predicateEvaluator.amounts.evaluate(
+            game.state,
+            DynamicAmounts.commanderCastsFromCommandZone(),
+            EffectContext(sourceId = null, controllerId = player),
+        )
+
+    init {
+        cardRegistry.register(commander)
+
+        test("counts the current cast from the command zone, including a cast that has not resolved") {
+            val game = scenario()
+                .withPlayers()
+                .withCardInCommandZone(1, commander.name)
+                .inPhase(Phase.PRECOMBAT_MAIN, Step.PRECOMBAT_MAIN)
+                .build()
+            val owner = game.player1Id
+            val cardId = game.state.getZone(ZoneKey(owner, Zone.COMMAND)).single()
+            game.state = game.state.updateEntity(cardId) { it.with(CommanderComponent(ownerId = owner)) }
+
+            amount(game, owner) shouldBe 0
+            game.execute(CastSpell(playerId = owner, cardId = cardId)).error shouldBe null
+            amount(game, owner) shouldBe 1
+        }
+
+        test("sums partner commanders for their owner and excludes the opponent") {
+            val game = scenario()
+                .withPlayers()
+                .withCardInCommandZone(1, commander.name)
+                .withCardInCommandZone(1, commander.name)
+                .withCardInCommandZone(2, commander.name)
+                .build()
+            val firstOwner = game.player1Id
+            val opponent = game.player2Id
+            val first = game.state.getZone(ZoneKey(firstOwner, Zone.COMMAND))[0]
+            val partner = game.state.getZone(ZoneKey(firstOwner, Zone.COMMAND))[1]
+            val enemy = game.state.getZone(ZoneKey(opponent, Zone.COMMAND)).single()
+            game.state = game.state
+                .updateEntity(first) { it.with(CommanderComponent(ownerId = firstOwner, castsFromCommandZone = 2)) }
+                .updateEntity(partner) { it.with(CommanderComponent(ownerId = firstOwner, castsFromCommandZone = 3)) }
+                .updateEntity(enemy) { it.with(CommanderComponent(ownerId = opponent, castsFromCommandZone = 20)) }
+
+            amount(game, firstOwner) shouldBe 5
+        }
+    }
+}
