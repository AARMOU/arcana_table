+        val exiledOutOfOwnersSight = frame.isFaceDown && frame.zoneType == Zone.EXILE && !isSpectator &&
+            frame.controllerId == viewingPlayerId &&
+            !visibility.isCardIdentityVisibleTo(state, zoneKey, entityId, viewingPlayerId, isSpectator)
+        if (frame.isFaceDown && (isSpectator || frame.controllerId != viewingPlayerId || exiledOutOfOwnersSight)) {
